---
// Salón de la Fama: muro de retratos de quienes ya no están en activo pero forman parte de la historia.
// Cada retrato está en penumbra y se enciende al entrar en pantalla (y al pasar el ratón), con el nombre en grande.
// Datos: shared/data/salon-fama-triplew.json (lista PROVISIONAL hasta que la Triple W la confirme).
import Base from '../layouts/Base.astro';
import Provisional from '../../../shared/components/Provisional.astro';
import hof from '../../../shared/data/salon-fama-triplew.json';
const pending = hof.members.some((m) => m.provisional);
---
<Base title={hof.title}>
  <section class="head wrap">
    <a class="back" href="/campeonatos/">← Campeonatos</a>
    <h1 class="hof-t">{[...hof.title].map((ch, k) => <span style={`--k:${k}`}>{ch === ' ' ? ' ' : ch}</span>)}</h1>
    <p class="intro">{hof.intro}</p>
    {pending && <p class="pend"><Provisional label="Lista por confirmar" /></p>}
  </section>

  <ul class="wall wrap" role="list">
    {hof.members.map((m) => (
      <li class="pl" data-reveal>
        <figure>
          <div class="ph">
            <img src={m.photo} alt={m.name} loading="lazy" style={`object-position:${m.photoPos || 'center 20%'}`} />
            <span class="beam" aria-hidden="true"></span>
          </div>
          <figcaption>
            <span class="nm">{m.name}</span>
            {(m.years || m.note) && <span class="meta">{[m.years, m.note].filter(Boolean).join(' · ')}</span>}
          </figcaption>
        </figure>
      </li>
    ))}
  </ul>
</Base>

<script>
  document.documentElement.classList.add('js');
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('lit-on'); io.unobserve(e.target); } }), { threshold: .35 });
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
</script>

<style>
  .head { padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 4vw, 3.5rem); text-align: center; position: relative; }
  .head::before { content: ''; position: absolute; inset: 0 10% 10%; z-index: -1; pointer-events: none; background: radial-gradient(ellipse 50% 70% at 50% 0%, rgba(232, 197, 71, .2), transparent 75%); filter: blur(20px); }
  .back { display: inline-block; margin-bottom: 1.8rem; font: 600 .95rem/1 var(--font-text); color: #c9c2b5; text-decoration: none; }
  .back:hover { color: var(--fg); }
  .hof-t { font: 900 clamp(3rem, 10vw, 8.5rem)/.85 var(--font-display); text-transform: uppercase; color: #E8C547; text-shadow: 0 0 22px rgba(232, 197, 71, .45); }
  .hof-t span { display: inline-block; }
  .intro { font-size: clamp(1.1rem, 1.6vw, 1.3rem); max-width: 44ch; margin: 1.5rem auto 0; color: #d6cfbf; }
  .pend { margin: 1rem 0 0; }

  /* Muro: cuatro columnas que bajan escalonadas, como placas colgadas a distinta altura */
  .wall { list-style: none; padding-bottom: clamp(4rem, 8vw, 7rem); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.8rem); }
  .pl { margin: 0; }
  .pl:nth-child(4n+2), .pl:nth-child(4n+4) { translate: 0 clamp(1.5rem, 4vw, 3.5rem); }
  .pl:nth-child(4n+1), .pl:nth-child(4n+3) { translate: 0 0; }
  figure { margin: 0; }
  .ph { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: #0c0c0e; }
  .ph img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.1) brightness(.95); transition: filter 1s cubic-bezier(.16, 1, .3, 1), transform 1.4s cubic-bezier(.16, 1, .3, 1); }
  .ph::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(0deg, #060607 0%, transparent 40%); }
  /* Foco blanco cálido desde arriba */
  .beam { position: absolute; inset: -10% 10% 30%; pointer-events: none; mix-blend-mode: screen; filter: blur(24px); opacity: .45; transition: opacity .8s; background: radial-gradient(ellipse 50% 70% at 50% 0%, rgba(255, 244, 225, .5), transparent 75%); }
  figcaption { position: relative; margin-top: -2.4rem; padding: 0 .9rem; }
  .nm { display: block; font: 900 clamp(1.5rem, 2.4vw, 2.2rem)/.9 var(--font-display); text-transform: uppercase; color: var(--fg); }
  .meta { display: block; margin-top: .4rem; font-size: .95rem; color: #c9c2b5; }
  .pl:hover .ph img { filter: grayscale(1) contrast(1.15) brightness(1.08); transform: scale(1.03); }
  .pl:hover .beam { opacity: .8; }
  .pl:hover .nm { color: #E8C547; }

  /* Encendido al entrar en pantalla */
  :global(.js) .pl:not(.lit-on) .ph img { filter: grayscale(1) brightness(.35); transform: scale(1.05); }
  :global(.js) .pl:not(.lit-on) .beam { opacity: 0; }
  :global(.js) .pl:not(.lit-on) figcaption { opacity: 0; translate: 0 .6rem; }
  :global(.js) .pl figcaption { transition: opacity .8s .2s, translate .8s .2s cubic-bezier(.16, 1, .3, 1); }

  @media (max-width: 900px) {
    .wall { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pl:nth-child(n) { translate: 0 0; }
    .pl:nth-child(2n) { translate: 0 2rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .pl .ph img, :global(.js) .pl figcaption { transition: none; }
  }
</style>
