---
import Base from '../layouts/Base.astro';
import Poster from '../components/Poster.astro';
import Cromo from '../components/Cromo.astro';
import FaceOff from '../components/FaceOff.astro';
import Entrada from '../components/Entrada.astro';
import Provisional from '../../../shared/components/Provisional.astro';
import home from '../../../shared/data/portada-triplew.json';
import { nextShow, upcomingShows, pastShows, venues, dateLong, ticketLabel, titles, wrestler, roster, urls } from '../../../shared/lib.js';

const s = nextShow;
const lastShow = pastShows.find((p) => p.results?.length);
const featured = (home.rosterFeatured ?? []).map(wrestler).filter(Boolean).slice(0, 10);
const champOf = (t) => t.holder && wrestler(t.holder);
---
<Base overlayHead>
  <!-- PORTADA: la entrada de los luchadores del próximo show -->
  {[s, ...upcomingShows.filter((x) => x !== s)].slice(0, 3).map((x, k) => <Entrada show={x} hidden={k > 0} />)}

  <!-- CARTELERA -->
  {s.card?.length > 0 && (
    <section class="section wrap">
      <div class="sec-head lit"><h2 class="h-l">Cartelera<span class="sub">{s.name}</span></h2><a href={`/shows/${s.slug}/`}>Todo el show</a></div>
      <div class="card-grid">{s.card.map((m) => <FaceOff match={m} color={s.color} />)}</div>
    </section>
  )}

  <!-- ENTRADA INVERSA: cartel de neón -->
  <section id="entrada-inversa" class="inversa">
    <div class="wrap inv-in">
      <h2 class="neon" data-neon>{home.inversa.lines.map((l, k) => <span style={`--k:${k}`}>{l}</span>)}</h2>
      <div class="inv-txt">
        <p>{home.inversa.text}</p>
        {home.inversa.note && <p class="muted">{home.inversa.note}</p>}
      </div>
    </div>
  </section>

  <!-- FOTOGRAMA A FOTOGRAMA: la secuencia avanza con el scroll -->
  <section class="seq" aria-label="Secuencia fotográfica">
    <div class="seq-sticky">
      <div class="seq-frames">
        {home.sequence.photos.map((f, i) => <img src={f.src} alt={f.alt} loading="lazy" data-i={i} class={i === 0 ? 'on' : ''} />)}
      </div>
      <div class="wrap seq-txt">
        <h2 class="h-l">{home.sequence.lines.map((l, k) => <span class:list={['seq-l', { accent: k === home.sequence.lines.length - 1 }]}>{l}</span>)}</h2>
        <div class="seq-bar"><span></span></div>
      </div>
    </div>
  </section>

  <!-- PRÓXIMOS SHOWS: carteles colgados bajo un foco -->
  <section class="section wrap">
    <div class="sec-head lit"><h2 class="h-l">Próximos shows</h2><a href="/shows/">Todos los shows</a></div>
    <div class="poster-row">{upcomingShows.map((x) => (
      <div class="pr-item" style={`--c:${x.color}`}>
        <div class="pr-hang"><Poster show={x} /></div>
        <p class="pr-date">{dateLong(x.date)}</p>
        <p class="pr-meta">{venues[x.venue].name}{ticketLabel(x) && <> · <span>{ticketLabel(x)}</span></>} {x.provisional && <Provisional label="Por confirmar" />}</p>
      </div>
    ))}</div>
  </section>

  <!-- CAMPEONES -->
  <section class="section champs-sec">
    <div class="wrap">
      <div class="sec-head lit"><h2 class="h-l">Campeones</h2><a href="/campeonatos/">Campeonatos</a></div>
      <div class="champs">
        {titles.map((t) => {
          const h = champOf(t);
          const img = h?.photos?.find((p) => p.includes('cinturon')) ?? h?.photo;
          return (
            <a class:list={['champ', { vacant: !h }]} href={h ? `/roster/${h.slug}/` : '/campeonatos/'} style={`--t:${t.color}`}>
              {img ? <img src={img} alt="" loading="lazy" style={`object-position:${(h.photoPos || 'center 20%').split(' ')[0]} 10%`} /> : <span class="champ-q" aria-hidden="true">{h ? h.name.slice(0, 1) : '?'}</span>}
              <span class="champ-txt">
                <span class="champ-t">{t.name}</span>
                <span class="champ-n">{h ? h.name : 'Vacante'}</span>
                {!h && <Provisional label="Por confirmar" />}
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ROSTER -->
  <section class="section wrap">
    <div class="sec-head lit"><h2 class="h-l">Roster<span class="sub">{roster.length} luchadores, equipos y staff</span></h2><a href="/roster/">Ver todos</a></div>
    <div class="cromos">{featured.map((w, i) => <Cromo w={w} n={i + 1} />)}</div>
    <p class="hint">Pasa el ratón o toca cada cromo para darle la vuelta.</p>
  </section>

  <!-- GALERÍA: cada foto se revela con un fogonazo de flash al aparecer -->
  <section class="section wrap">
    <div class="sec-head lit"><h2 class="h-l">Galería</h2><a href={home.gallery.link}>{home.gallery.linkLabel} ↗</a></div>
    <div class="mosaic">
      {home.gallery.photos.map((f) => (
        <figure class:list={['m', { w: f.shape === 'wide', t: f.shape === 'tall' }]}><img src={f.src} alt={f.alt} loading="lazy" /></figure>
      ))}
    </div>
  </section>

  <!-- ÚLTIMOS RESULTADOS: marcador LED -->
  {lastShow && (
    <section class="section results-sec" style={`--c:${lastShow.color}`}>
      <div class="wrap res-in">
        <div class="res-poster"><Poster show={lastShow} size="l" /></div>
        <div>
          <h2 class="h-l">{lastShow.name}<span class="sub">Resultados del {dateLong(lastShow.date)}</span></h2>
          <ol class="board">{lastShow.results.map((r, k) => <li><b>{String(k + 1).padStart(2, '0')}</b><span>{r.text} {r.provisional && <Provisional label="Por confirmar" />}</span></li>)}</ol>
          <a class="btn ghost" href={`/shows/${lastShow.slug}/`}>Crónica y galería</a>
        </div>
      </div>
    </section>
  )}

  <!-- LUCHARAMA -->
  <section class="school wrap">
    <div class="school-in">
      <h2 class="h-xl">{home.school.lines.map((l) => <span>{l}</span>)}</h2>
      <div class="school-txt">
        <p>{home.school.text}</p>
        <a class="btn" href={urls.lucharama}>{home.school.cta} →</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Neón: se enciende al entrar en pantalla. Galería: fogonazo de flash al aparecer cada foto.
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('lit-on'); io.unobserve(e.target); } }), { threshold: .35 });
  document.querySelectorAll('[data-neon], .m').forEach((el) => io.observe(el));
  document.documentElement.classList.add('js');
  const seq = document.querySelector('.seq');
  if (seq) {
    const frames = seq.querySelectorAll('.seq-frames img');
    const bar = seq.querySelector('.seq-bar span');
    const onScroll = () => {
      const r = seq.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, -r.top / (r.height - innerHeight)));
      const i = Math.min(frames.length - 1, Math.floor(p * frames.length));
      frames.forEach((f, k) => f.classList.toggle('on', k === i));
      bar.style.transform = `scaleX(${p})`;
    };
    addEventListener('scroll', onScroll, { passive: true }); onScroll();
  }
</script>

<style>
  .sec-head h2 { display: grid; }
  .sub { display: block; font: 600 clamp(1rem, 1.4vw, 1.2rem)/1.3 var(--font-text); text-transform: none; letter-spacing: 0; color: #b9b3a8; margin-top: .7rem; }

  .card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); gap: 1.2rem; }

  /* Entrada inversa: cartel de neón */
  .inversa { background: #060607; border-block: 1px solid #1a1a1c; padding-block: clamp(4rem, 9vw, 8rem); overflow: hidden;
    background-image: radial-gradient(ellipse 60% 70% at 25% 50%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 70%); }
  .inv-in { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .neon { font: 800 clamp(3.4rem, 9vw, 8rem)/.9 var(--font-display); text-transform: uppercase; display: grid; }
  .neon span { color: transparent; -webkit-text-stroke: clamp(1.5px, .2vw, 2.5px) color-mix(in srgb, var(--accent) 35%, #fff); filter: drop-shadow(0 0 2px var(--accent)) drop-shadow(0 0 14px var(--accent)) drop-shadow(0 0 40px color-mix(in srgb, var(--accent) 60%, transparent)); }
  .neon span:last-child { color: color-mix(in srgb, var(--accent) 25%, #fff); -webkit-text-stroke: 0; }
  :global(.js) .neon span { opacity: .12; filter: none; }
  :global(.js) .neon.lit-on span { animation: neon-on 1.4s steps(1) both; animation-delay: calc(var(--k) * .45s); }
  @keyframes neon-on { 0% { opacity: .12; filter: none; } 10% { opacity: 1; filter: drop-shadow(0 0 2px var(--accent)) drop-shadow(0 0 14px var(--accent)) drop-shadow(0 0 40px color-mix(in srgb, var(--accent) 60%, transparent)); } 18% { opacity: .2; filter: none; } 26%, 100% { opacity: 1; filter: drop-shadow(0 0 2px var(--accent)) drop-shadow(0 0 14px var(--accent)) drop-shadow(0 0 40px color-mix(in srgb, var(--accent) 60%, transparent)); } }
  .inv-txt { font-size: 1.1rem; line-height: 1.55; max-width: 44ch; color: #d9d3c7; }
  .inv-txt .muted { color: #a8a196; }
  @media (max-width: 820px) { .inv-in { grid-template-columns: 1fr; } }

  /* Secuencia */
  .seq { height: 320vh; position: relative; }
  .seq-sticky { position: sticky; top: 0; height: 100vh; overflow: hidden; display: grid; align-items: end; }
  .seq-frames { position: absolute; inset: 0; }
  .seq-frames img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; }
  .seq-frames img.on { opacity: 1; }
  .seq-sticky::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(11,11,11,.92) 0%, transparent 55%); pointer-events: none; }
  .seq-txt { position: relative; z-index: 1; padding-block: 3rem; }
  .seq-l { display: block; }
  .seq-bar { height: 3px; background: var(--line); margin-top: 1.5rem; max-width: 320px; }
  .seq-bar span { display: block; height: 100%; background: var(--accent); transform-origin: left; transform: scaleX(0); }

  /* Próximos shows: carteles colgados, cada uno con su foco */
  .poster-row { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: clamp(1.5rem, 3vw, 2.5rem); }
  .pr-hang { position: relative; padding-top: 2.4rem; }
  .pr-hang::before { content: ''; position: absolute; z-index: 2; inset: 0 0 30% 0; pointer-events: none; mix-blend-mode: screen; opacity: .5; transition: opacity .4s;
    background: radial-gradient(ellipse 50% 70% at 50% 0%, color-mix(in srgb, var(--c) 50%, #fff) 0%, transparent 70%); }
  .pr-item:hover .pr-hang::before { opacity: .9; }
  .pr-date { font: 800 1.4rem/1 var(--font-display); text-transform: uppercase; margin: 1rem 0 .35rem; color: var(--c); }
  .pr-meta { font-size: 1rem; color: #b9b3a8; margin: 0; }

  /* Campeones */
  .champs-sec { background: #08080a; border-block: 1px solid #1a1a1c; }
  .champs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(46%, 240px), 1fr)); gap: 1rem; }
  .champ { position: relative; aspect-ratio: 3/4; overflow: hidden; text-decoration: none; background: #0e0e10; isolation: isolate; }
  .champ img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.15) brightness(.85); transition: transform .8s cubic-bezier(.16, 1, .3, 1), filter .5s; }
  .champ::before { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; mix-blend-mode: screen; background: radial-gradient(ellipse 60% 55% at 50% -5%, color-mix(in srgb, var(--t) 70%, transparent), transparent 75%); opacity: .75; transition: opacity .4s; }
  .champ::after { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(0deg, #050506 0%, rgba(5,5,6,0) 50%); }
  .champ:hover img { transform: scale(1.04); filter: grayscale(1) contrast(1.2) brightness(1); }
  .champ:hover::before { opacity: 1; }
  .champ-q { position: absolute; inset: 0; display: grid; place-items: center; font: 900 12rem/1 var(--font-display); color: transparent; -webkit-text-stroke: 2px color-mix(in srgb, var(--t) 60%, #333); }
  .champ-txt { position: absolute; z-index: 2; inset: auto 0 0 0; padding: 1rem 1rem 1.1rem; display: grid; gap: .45rem; justify-items: start; border-top: 3px solid var(--t); }
  .champ-t { font: 600 .95rem/1.2 var(--font-text); color: #e9e3d6; }
  .champ-n { font: 900 clamp(1.8rem, 3vw, 2.6rem)/.88 var(--font-display); text-transform: uppercase; }

  .cromos { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(46%, 210px), 1fr)); gap: 1rem; }
  .hint { font-size: .95rem; margin-top: 1rem; color: #a8a196; }

  /* Galería */
  .mosaic { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: clamp(140px, 18vw, 260px); grid-auto-flow: dense; gap: .5rem; }
  .m { margin: 0; overflow: hidden; background: #111; }
  .m.w { grid-column: span 2; }
  .m.t { grid-row: span 2; }
  .m img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; transition: transform .6s ease; }
  .m:hover img { transform: scale(1.04); }
  :global(.js) .m img { filter: brightness(.08); }
  :global(.js) .m.lit-on img { animation: flash 1.1s cubic-bezier(.2, .8, .2, 1) both; }
  @keyframes flash { 0% { filter: brightness(.08); } 12% { filter: brightness(2.6) contrast(.7); } 100% { filter: none; } }
  @media (max-width: 700px) { .mosaic { grid-template-columns: repeat(2, 1fr); } }

  /* Resultados: marcador LED */
  .results-sec { background: #060607; border-block: 1px solid #1a1a1c; }
  .res-in { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr); gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .results-sec h2 { display: grid; }
  .board { list-style: none; padding: 0; margin: 1.8rem 0 2rem; border-top: 2px solid var(--c); background-color: #0c0a0b; background-image: radial-gradient(color-mix(in srgb, var(--c) 14%, transparent) 1.1px, transparent 1.3px); background-size: 5px 5px; }
  .board li { display: grid; grid-template-columns: 3.2rem 1fr; gap: .9rem; align-items: baseline; padding: .9rem 1rem; border-bottom: 1px solid #1e1a1c; font-size: 1.02rem; line-height: 1.45; color: #e7e1d6; }
  .board b { font: 900 1.8rem/1 var(--font-display); color: var(--c); text-shadow: 0 0 12px color-mix(in srgb, var(--c) 55%, transparent); font-variant-numeric: tabular-nums; }
  @media (max-width: 820px) { .res-in { grid-template-columns: 1fr; } .res-poster { max-width: 360px; } }

  /* Lucharama */
  .school { padding-block: 4rem 2rem; }
  .school-in { border: 1px solid #2a1414; padding: clamp(1.5rem, 5vw, 4rem); display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: end;
    background: radial-gradient(circle, rgba(226,35,26,.3) 1px, transparent 1.6px) 0 0 / 7px 7px, #120606; }
  .school .h-xl { color: #F3E6D0; display: grid; }
  .school .btn { --accent: #E2231A; --accent-ink: #fff; }
  .school-txt { font-size: 1.1rem; max-width: 42ch; color: #e8dcc8; }
  @media (max-width: 820px) { .school-in { grid-template-columns: 1fr; } }
</style>
