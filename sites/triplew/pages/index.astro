---
import Base from '../layouts/Base.astro';
import Poster from '../components/Poster.astro';
import Cromo from '../components/Cromo.astro';
import FaceOff from '../components/FaceOff.astro';
import PhotoSlot from '../../../shared/components/PhotoSlot.astro';
import Provisional from '../../../shared/components/Provisional.astro';
import { nextShow, upcomingShows, pastShows, venues, dateLong, ticketLabel, titles, wrestler, roster, urls, initials } from '../../../shared/lib.js';

const s = nextShow;
const v = venues[s.venue];
const lastShow = pastShows.find((p) => p.results?.length);
const featured = ['rizo', 'trevor-de-vries', 'jon-valow', 'joro', 'newt-nova', 'ochoa', 'super-franki', 'la-nueva-ola'].map(wrestler);
const startISO = `${s.date}T${s.start || '18:00'}:00+01:00`;
---
<Base>
  <!-- PORTADA: el próximo show manda en el color de toda la web -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <PhotoSlot src="/fotos/f76.jpg" alt="Luchador lanzándose en plancha bajo luz azul en el Gimnasio Lucharama" tone="#0b0b0b" ink={s.color} ratio="auto" pos="70% 40%" eager />
    </div>
    <div class="wrap hero-in">
      <p class="kicker">Próximo show</p>
      <h1 class="hero-title">{s.name.split(' ').map((w) => <span>{w} </span>)}</h1>
      <p class="hero-tag">{s.tagline}</p>
      <dl class="hero-meta">
        <div><dt>Fecha</dt><dd>{dateLong(s.date)}</dd></div>
        <div><dt>Hora</dt><dd>{s.doors ? `Puertas ${s.doors} · ` : ''}Inicio {s.start}</dd></div>
        <div><dt>Lugar</dt><dd><a href={v.map}>{v.name}</a></dd></div>
      </dl>
      <div class="countdown" data-start={startISO} aria-label="Cuenta atrás">
        <span><b data-u="d">--</b>días</span><span><b data-u="h">--</b>horas</span><span><b data-u="m">--</b>min</span><span><b data-u="s">--</b>seg</span>
      </div>
      <div class="hero-cta">
        {s.ticket?.type === 'venta' && <a class="btn" href={s.ticket.url}>Compra tu entrada →</a>}
        {s.ticket?.type === 'inversa' && <a class="btn" href="#entrada-inversa">Entrada inversa: pagas al salir</a>}
        <a class="btn ghost" href={`/shows/${s.slug}/`}>Ver cartelera</a>
      </div>
    </div>
  </section>

  <!-- CARTELERA -->
  {s.card?.length > 0 && (
    <section class="section wrap">
      <div class="sec-head"><div><p class="kicker">Cartelera</p><h2 class="h-l">{s.name}</h2></div><a href={`/shows/${s.slug}/`}>Todo el show</a></div>
      <div class="card-grid">{s.card.map((m) => <FaceOff match={m} color={s.color} ink={s.ink} />)}</div>
    </section>
  )}

  <!-- ENTRADA INVERSA -->
  <section id="entrada-inversa" class="inversa">
    <div class="wrap inv-in">
      <h2 class="h-l">Entra gratis.<br /><span class="accent">Paga lo que creas</span><br />al salir.</h2>
      <div>
        <p>Los shows en el Gimnasio Lucharama funcionan con <strong>entrada inversa</strong>: no hay taquilla a la entrada. Ves el show completo y, al terminar, aportas lo que consideres que ha valido.</p>
        <p class="muted">Los eventos especiales en salas (como Top 1 en Sala Revi) tienen entrada anticipada.</p>
      </div>
    </div>
  </section>


  <!-- FOTOGRAMA A FOTOGRAMA: la secuencia avanza con el scroll -->
  <section class="seq" aria-label="Secuencia fotográfica">
    <div class="seq-sticky">
      <div class="seq-frames">
        {['f45', 'f46', 'f47', 'f48'].map((f, i) => <img src={`/fotos/${f}.jpg`} alt={i === 0 ? 'Secuencia de un combate, fotograma a fotograma' : ''} loading="lazy" data-i={i} class={i === 0 ? 'on' : ''} />)}
      </div>
      <div class="wrap seq-txt">
        <p class="kicker">Fotograma a fotograma</p>
        <h2 class="h-l">Cinco minutos<br />que se te pasan<br /><span class="accent">volando.</span></h2>
        <div class="seq-bar"><span></span></div>
      </div>
    </div>
  </section>

  <!-- PRÓXIMOS -->
  <section class="section wrap">
    <div class="sec-head"><div><p class="kicker">Calendario</p><h2 class="h-l">Próximos shows</h2></div><a href="/shows/">Todos los shows</a></div>
    <div class="poster-row">{upcomingShows.map((x) => (
      <div class="pr-item">
        <Poster show={x} />
        <p class="pr-meta">{dateLong(x.date)} · {venues[x.venue].name}{ticketLabel(x) && <> · <span class="accent">{ticketLabel(x)}</span></>} {x.provisional && <Provisional />}</p>
      </div>
    ))}</div>
  </section>

  <!-- CAMPEONES -->
  <section class="section champs-sec">
    <div class="wrap">
      <div class="sec-head"><div><p class="kicker">Oro de la Triple W</p><h2 class="h-l">Campeones actuales</h2></div><a href="/campeonatos/">Campeonatos</a></div>
      <div class="champs">
        {titles.map((t) => {
          const h = t.holder && wrestler(t.holder);
          return (
            <a class="champ" href={h ? `/roster/${h.slug}/` : '/campeonatos/'} style={`--t:${t.color}`}>
              <PhotoSlot initials={h ? initials(h.name) : '?'} tone="#121212" ink={t.color} ratio="4/5" label="Foto con el cinturón" />
              <div class="champ-txt">
                <span class="champ-t">{t.name}</span>
                <span class="champ-n">{h ? h.name : 'Vacante / por confirmar'}</span>
                {!h && <Provisional />}
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ROSTER -->
  <section class="section wrap">
    <div class="sec-head"><div><p class="kicker">{roster.length} luchadores, equipos y staff</p><h2 class="h-l">El roster</h2></div><a href="/roster/">Ver todos</a></div>
    <div class="cromos">{featured.map((w, i) => <Cromo w={w} n={i + 1} />)}</div>
    <p class="muted hint">Pasa el ratón (o toca) cada cromo para darle la vuelta.</p>
  </section>


  <!-- GALERÍA -->
  <section class="section wrap">
    <div class="sec-head"><div><p class="kicker">Desde ringside</p><h2 class="h-l">Galería</h2></div><a href="https://www.instagram.com/wrestlingphotoshow/">@wrestlingphotoshow ↗</a></div>
    <div class="mosaic">
      {[['f72','w'],['f70','t'],['f58',''],['f43','t'],['f64',''],['f49','w'],['f71','t'],['f66',''],['f81','w'],['f44','']].map(([f, c]) => (
        <figure class={`m ${c}`}><img src={`/fotos/${f}.jpg`} alt="Foto de un show de la Triple W" loading="lazy" /></figure>
      ))}
    </div>
  </section>

  <!-- ÚLTIMOS RESULTADOS -->
  {lastShow && (
    <section class="section results-sec" style={`--accent:${lastShow.color}`}>
      <div class="wrap res-in">
        <div class="res-poster"><Poster show={lastShow} size="l" /></div>
        <div>
          <p class="kicker">Resultados · {dateLong(lastShow.date)}</p>
          <h2 class="h-l">{lastShow.name}</h2>
          <ol class="res-list">{lastShow.results.map((r) => <li>{r.text} {r.provisional && <Provisional />}</li>)}</ol>
          <a class="btn ghost" href={`/shows/${lastShow.slug}/`}>Crónica y galería</a>
        </div>
      </div>
    </section>
  )}

  <!-- LUCHARAMA -->
  <section class="school wrap">
    <div class="school-in">
      <div>
        <p class="kicker">Escuela oficial</p>
        <h2 class="h-xl">¿Quieres<br />subirte<br />al ring?</h2>
      </div>
      <div class="school-txt">
        <p>Todo el roster de la Triple W ha pasado por <strong>Lucharama</strong>, nuestra escuela en Carabanchel. Desde 14 años, sin experiencia previa. <strong>La primera clase es gratis.</strong></p>
        <a class="btn" href={urls.lucharama}>Conoce Lucharama →</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const el = document.querySelector('.countdown');
  if (el) {
    const t = new Date(el.dataset.start).getTime();
    const set = (u, v) => { const n = el.querySelector(`[data-u="${u}"]`); if (n) n.textContent = String(v).padStart(2, '0'); };
    const tick = () => {
      let d = Math.max(0, t - Date.now()) / 1000;
      set('d', Math.floor(d / 86400)); d %= 86400; set('h', Math.floor(d / 3600)); d %= 3600; set('m', Math.floor(d / 60)); set('s', Math.floor(d % 60));
    };
    tick(); setInterval(tick, 1000);
  }
  const seq = document.querySelector('.seq');
  if (seq) {
    const frames = seq.querySelectorAll('.seq-frames img');
    const bar = seq.querySelector('.seq-bar span');
    const onScroll = () => {
      const r = seq.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, -r.top / (r.height - innerHeight)));
      const i = Math.min(frames.length - 1, Math.floor(p * frames.length));
      frames.forEach((f, k) => f.classList.toggle('on', k === i));
      bar.style.transform = `scaleX(${p})`;
    };
    addEventListener('scroll', onScroll, { passive: true }); onScroll();
  }
</script>

<style>
  .hero { position: relative; min-height: min(92vh, 900px); display: grid; align-items: end; overflow: hidden; border-bottom: 6px solid var(--accent); }
  .hero-bg { position: absolute; inset: 0; }
  .hero-bg :global(.slot) { height: 100%; }
  .hero-bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(11,11,11,.95) 0%, rgba(11,11,11,.7) 45%, color-mix(in srgb, var(--accent) 25%, transparent) 100%), linear-gradient(0deg, #0b0b0b 0%, transparent 40%); }
  .hero-in { position: relative; padding-block: 5rem 3rem; }
  .hero-title { font-size: clamp(3.6rem, 13vw, 11rem); line-height: .8; max-width: 14ch; color: var(--accent); }
  .hero-title span:nth-child(even) { color: var(--fg); }
  .hero-tag { font-size: clamp(1.05rem, 1.6vw, 1.3rem); max-width: 40ch; margin-top: 1.4rem; }
  .hero-meta { display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; margin: 2rem 0 1.5rem; }
  .hero-meta dt { font: 700 .62rem/1 var(--font-text); letter-spacing: .18em; text-transform: uppercase; color: var(--muted); margin-bottom: .35rem; }
  .hero-meta dd { margin: 0; font: 800 1.35rem/1 var(--font-display); text-transform: uppercase; }
  .countdown { display: flex; gap: .5rem; margin-bottom: 2rem; }
  .countdown span { display: grid; text-align: center; min-width: 4.4rem; padding: .6rem .4rem; border: 1px solid var(--line); background: rgba(0,0,0,.4); font: 700 .58rem/1 var(--font-text); letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .countdown b { font: 900 2.2rem/1 var(--font-display); color: var(--fg); margin-bottom: .2rem; font-variant-numeric: tabular-nums; }
  .hero-cta { display: flex; gap: .8rem; flex-wrap: wrap; }


  .seq { height: 320vh; position: relative; }
  .seq-sticky { position: sticky; top: 0; height: 100vh; overflow: hidden; display: grid; align-items: end; }
  .seq-frames { position: absolute; inset: 0; }
  .seq-frames img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; }
  .seq-frames img.on { opacity: 1; }
  .seq-sticky::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(11,11,11,.92) 0%, transparent 55%); pointer-events: none; }
  .seq-txt { position: relative; z-index: 1; padding-block: 3rem; }
  .seq-bar { height: 3px; background: var(--line); margin-top: 1.5rem; max-width: 320px; }
  .seq-bar span { display: block; height: 100%; background: var(--accent); transform-origin: left; transform: scaleX(0); }

  .mosaic { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: clamp(140px, 18vw, 260px); grid-auto-flow: dense; gap: .5rem; }
  .m { margin: 0; overflow: hidden; background: #151515; }
  .m.w { grid-column: span 2; }
  .m.t { grid-row: span 2; }
  .m img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; transition: transform .5s ease; }
  .m:hover img { transform: scale(1.04); }
  @media (max-width: 700px) { .mosaic { grid-template-columns: repeat(2, 1fr); } }

  .card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 1.2rem; }

  .inversa { background: var(--accent); color: var(--accent-ink); padding-block: clamp(3rem, 7vw, 6rem); }
  .inversa .accent { color: var(--accent-ink); -webkit-text-stroke: 2px var(--accent-ink); color: transparent; }
  .inv-in { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2rem; align-items: end; font-size: 1.1rem; }
  .inversa .muted { color: inherit; opacity: .75; }
  @media (max-width: 820px) { .inv-in { grid-template-columns: 1fr; } }

  .poster-row { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(46%, 260px), 1fr)); gap: 1.4rem; }
  .pr-meta { font-size: .85rem; margin-top: .7rem; color: var(--muted); }

  .champs-sec { background: #101010; border-block: 1px solid var(--line); }
  .champs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(46%, 230px), 1fr)); gap: 1rem; }
  .champ { position: relative; text-decoration: none; border-top: 4px solid var(--t); }
  .champ-txt { position: absolute; inset: auto 0 0 0; padding: 2.5rem 1rem 1rem; background: linear-gradient(transparent, #000); display: grid; gap: .3rem; justify-items: start; }
  .champ-t { font: 700 .62rem/1 var(--font-text); letter-spacing: .16em; text-transform: uppercase; color: var(--t); }
  .champ-n { font: 900 clamp(1.3rem, 4vw, 2rem)/.9 var(--font-display); text-transform: uppercase; }

  .cromos { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(46%, 220px), 1fr)); gap: 1rem; }
  .hint { font-size: .8rem; margin-top: 1rem; }

  .results-sec { background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 14%, #0b0b0b), #0b0b0b); }
  .res-in { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .res-list { padding-left: 1.2rem; margin: 1.5rem 0 2rem; display: grid; gap: .8rem; }
  .res-list li::marker { color: var(--accent); font-weight: 800; }
  @media (max-width: 820px) { .res-in { grid-template-columns: 1fr; } .res-poster { max-width: 360px; } }

  .school { padding-block: 4rem 2rem; }
  .school-in { border: 1px solid var(--line); padding: clamp(1.5rem, 5vw, 4rem); display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: end;
    background: radial-gradient(circle, rgba(226,35,26,.35) 1px, transparent 1.6px) 0 0 / 7px 7px, #120606; }
  .school .kicker, .school .h-xl { color: #F3E6D0; }
  .school .kicker { color: #E2231A; }
  .school .btn { --accent: #E2231A; --accent-ink: #fff; }
  .school-txt { font-size: 1.1rem; max-width: 42ch; }
  @media (max-width: 820px) { .school-in { grid-template-columns: 1fr; } }
</style>
