---
import Base from '../layouts/Base.astro';
import Provisional from '../../../shared/components/Provisional.astro';
---
<Base title="Aviso legal y privacidad">
  <section class="section wrap" style="max-width:780px">
    <h1 class="h-l">Aviso legal y privacidad</h1>
    <p><Provisional label="Texto pendiente" /></p>
    <p class="muted">Esta página tendrá el aviso legal, la política de privacidad y la de cookies. Hace falta el nombre legal de la asociación, su CIF, domicilio y un email de contacto para protección de datos.</p>
  </section>
</Base>
