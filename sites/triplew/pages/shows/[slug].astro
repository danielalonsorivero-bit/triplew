---
import Base from '../../layouts/Base.astro';
import Poster from '../../components/Poster.astro';
import FaceOff from '../../components/FaceOff.astro';
import Galeria from '../../components/Galeria.astro';
import VideoYT from '../../components/VideoYT.astro';
import pages from '../../../../shared/data/paginas-triplew.json';
import Provisional from '../../../../shared/components/Provisional.astro';
import { allShows, venues, dateLong, cronicaBlocks } from '../../../../shared/lib.js';
export function getStaticPaths() { return allShows.map((s) => ({ params: { slug: s.slug }, props: { s: s } })); }
const { s } = Astro.props;
const v = venues[s.venue];
const today = new Date(new Date().toISOString().slice(0, 10));
const past = new Date(s.date) < today;
const words = s.name.split(' ');
const cronica = cronicaBlocks(s.cronica);
let n = 0;
---
<Base title={s.name} accent={s.color} accentInk={s.ink} overlayHead>
  <section class="top" style={`--c:${s.color}`}>
    <div class="top-bg" aria-hidden="true">{s.poster && <img src={s.poster} alt="" />}<span class="beam b1"><i></i></span><span class="beam b2"><i></i></span></div>
    <div class="wrap top-in">
      <div>
        <p class="brand-line">{s.brand === 'levelone' ? 'Level One' : 'WhiteWolf Wrestling'} {past ? 'presentó' : 'presenta'}</p>
        <h1 class="show-name" aria-label={s.name}>{words.map((w, k) => <span class:list={['wd', { o: k % 2 === 1 }]} aria-hidden="true">{[...w].map((ch) => <span class="ch" style={`--c2:${n++}`}>{ch}</span>)}</span>)}</h1>
        {s.tagline && <p class="tag">{s.tagline}</p>}
        {s.provisional && <p><Provisional label="Datos de este show por confirmar" /></p>}
        <dl class="board">
          <div><dt>Fecha</dt><dd>{dateLong(s.date)}</dd></div>
          {s.start && <div><dt>Hora</dt><dd>{s.start}{s.doors && <small>Puertas {s.doors}</small>}</dd></div>}
          <div><dt>Lugar</dt><dd><a href={v.map}>{v.name}</a><small>{v.address}</small></dd></div>
          <div><dt>Entrada</dt><dd>{s.ticket?.type === 'venta' ? 'Anticipada' : 'Gratis, pagas al salir'}</dd></div>
        </dl>
        {!past && (
          <div class="cta">
            {s.ticket?.type === 'venta' ? <a class="btn" href={s.ticket.url}>Compra tu entrada</a> : <a class="btn" href={v.map}>Cómo llegar</a>}
          </div>
        )}
      </div>
      <div class="poster-col"><Poster show={s} size="l" /></div>
    </div>
  </section>

  {!past && (
    <section class="section wrap">
      <h2 class="h-l">Cartelera</h2>
      {s.card?.length ? <div class="cards">{s.card.map((m) => <FaceOff match={m} color={s.color} />)}</div>
        : <p class="soon">La cartelera se anunciará en las próximas semanas. Síguela en <a href="https://www.instagram.com/latriplew/">@latriplew</a>.</p>}
    </section>
  )}

  {past && (
    <section class="section wrap">
      <h2 class="h-l">Resultados</h2>
      {s.results?.length
        ? <ol class="results">{s.results.map((r, k) => <li><b>{String(k + 1).padStart(2, '0')}</b><span>{r.text} {r.provisional && <Provisional label="Por confirmar" />}</span></li>)}</ol>
        : <p class="soon">Resultados pendientes de publicar.</p>}
      <a class="btn ghost yt-link" href={s.video || pages.sitio.youtube}>{s.video ? 'Ver el show en YouTube' : 'Ve todos los combates en nuestro canal de YouTube'} <span class="arr" aria-hidden="true"></span></a>
    </section>
  )}

  {cronica.length > 0 && (
    <section class="section wrap cron-sec">
      <h2 class="h-l">Crónica</h2>
      <div class="cron">{cronica.map((b) => b.kind === 'h' ? <h3 set:html={b.html} /> : <p set:html={b.html} />)}</div>
    </section>
  )}

  {s.videos?.length > 0 && (
    <section class="section wrap gal-sec">
      <h2 class="h-l">Vídeos</h2>
      <div class="vid-grid">{s.videos.map((v) => <VideoYT id={v.youtube} title={v.title} color={s.color} />)}</div>
    </section>
  )}

  {s.gallery?.length > 0 && (
    <section class="section wrap gal-sec">
      <h2 class="h-l">Galería</h2>
      {s.galleryProvisional && <p class="soon"><Provisional label="Fotos por confirmar en este show" /></p>}
      <Galeria photos={s.gallery} alt={`Foto de ${s.name}`} max={30} />
    </section>
  )}
</Base>
<style>
  .top { position: relative; overflow: hidden; isolation: isolate; margin-top: -65px; padding-top: 65px; background: #050506; border-bottom: 2px solid var(--c); }
  .top-bg { position: absolute; inset: 0; z-index: -1; }
  .top-bg img { position: absolute; inset: -10%; width: 120%; height: 120%; object-fit: cover; filter: blur(40px) saturate(1.2) brightness(.35); }
  .top-bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(5,5,6,.92) 0%, rgba(5,5,6,.6) 55%, rgba(5,5,6,.3) 100%); }
  .beam { position: absolute; z-index: 1; top: -14%; width: 28vw; min-width: 240px; height: 140%; transform-origin: 50% 0; mix-blend-mode: screen; filter: blur(clamp(18px, 2vw, 34px)); opacity: .6; }
  .beam i { position: absolute; inset: 0; clip-path: polygon(46% 0, 54% 0, 100% 100%, 0 100%); background: radial-gradient(ellipse 60% 90% at 50% 0%, color-mix(in srgb, var(--c) 45%, #fff) 0%, color-mix(in srgb, var(--c) 25%, transparent) 40%, transparent 85%); }
  .b1 { left: 58%; animation: sweep 10s ease-in-out infinite alternate; }
  .b2 { left: 76%; animation: sweep 8s ease-in-out -3s infinite alternate-reverse; opacity: .4; }
  @keyframes sweep { from { rotate: 16deg; } to { rotate: -12deg; } }
  .top-in { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, .7fr); gap: clamp(2rem, 5vw, 4rem); padding-block: clamp(3rem, 7vw, 6rem); align-items: center; }
  .brand-line { font: 700 1rem/1 var(--font-text); color: var(--c); margin: 0 0 1rem; }
  .show-name { font: 900 clamp(3.4rem, 9vw, 8.5rem)/.82 var(--font-display); text-transform: uppercase; display: flex; flex-wrap: wrap; column-gap: .22em; }
  .wd { white-space: nowrap; }
  .wd.o { color: transparent; -webkit-text-stroke: clamp(1.5px, .16vw, 2.5px) var(--fg); }
  .ch { display: inline-block; animation: slam .7s cubic-bezier(.16, 1, .3, 1) both; animation-delay: calc(.3s + var(--c2) * .04s); }
  @keyframes slam { 0% { opacity: 0; transform: translateY(-.12em) scale(2.4); filter: blur(18px); } 55% { opacity: 1; } 100% { opacity: 1; transform: none; filter: none; } }
  .tag { font-size: clamp(1.1rem, 1.6vw, 1.35rem); margin: 1.3rem 0 0; max-width: 42ch; color: #e2dccf; }
  .board { margin: 2rem 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); border-top: 2px solid var(--c); background-color: rgba(10,9,9,.8); background-image: radial-gradient(color-mix(in srgb, var(--c) 14%, transparent) 1.1px, transparent 1.3px); background-size: 5px 5px; }
  .board div { padding: 1rem; border-bottom: 1px solid #1d1d20; }
  .board dt { font: 600 .95rem/1 var(--font-text); color: #b9b3a8; margin-bottom: .5rem; }
  .board dd { margin: 0; font: 800 1.35rem/1.05 var(--font-display); text-transform: uppercase; color: var(--c); }
  .board dd a { color: inherit; }
  .board small { display: block; font: 400 .95rem/1.3 var(--font-text); text-transform: none; color: #c9c2b5; margin-top: .35rem; }
  .cta { margin-top: 1.6rem; }
  .cta .btn { background: var(--c); color: var(--accent-ink); }
  .poster-col { position: relative; }
  .poster-col::before { content: ''; position: absolute; z-index: 1; inset: -10% 5% 35%; pointer-events: none; mix-blend-mode: screen; filter: blur(26px); background: radial-gradient(ellipse 42% 58% at 50% 18%, color-mix(in srgb, var(--c) 40%, #fff), transparent 72%); opacity: .55; }
  @media (max-width: 820px) { .top-in { grid-template-columns: 1fr; } .poster-col { max-width: 340px; } }

  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); gap: 1.2rem; margin-top: 2rem; }
  .soon { font-size: 1.1rem; color: #c9c2b5; margin-top: 1.2rem; max-width: 60ch; }
  .results { list-style: none; padding: 0; margin: 2rem 0 0; max-width: 900px; border-top: 2px solid var(--accent); background-color: #0c0a0b; background-image: radial-gradient(color-mix(in srgb, var(--accent) 14%, transparent) 1.1px, transparent 1.3px); background-size: 5px 5px; }
  .results li { display: grid; grid-template-columns: 3.2rem 1fr; gap: .9rem; align-items: baseline; padding: 1rem; border-bottom: 1px solid #1e1a1c; font-size: 1.05rem; line-height: 1.45; }
  .results b { font: 900 1.8rem/1 var(--font-display); color: var(--accent); font-variant-numeric: tabular-nums; }
  .gal-sec { padding-top: 0; }
  .yt-link { margin-top: 1.6rem; }
  .cron-sec { padding-top: 0; }
  .cron { max-width: 68ch; margin-top: 1.5rem; border-left: 2px solid var(--accent); padding-left: clamp(1rem, 3vw, 2rem); }
  .cron p { font-size: 1.1rem; line-height: 1.65; color: #ddd6c8; margin: 0 0 1.1rem; }
  .cron h3 { font: 900 clamp(1.6rem, 3vw, 2.2rem)/1 var(--font-display); text-transform: uppercase; color: var(--accent); margin: 2rem 0 .8rem; }
  .cron :global(a) { color: var(--fg); font-weight: 700; text-decoration-color: var(--accent); text-underline-offset: .18em; }
  .cron :global(a:hover) { color: var(--accent); }
  .vid-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); gap: 1.5rem; margin-top: 1.5rem; max-width: 980px; }
  .gal { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; margin-top: 1.5rem; }
  .gal figure { margin: 0; aspect-ratio: 1; overflow: hidden; background: #111; }
  .gal figure.wide { grid-column: 1 / -1; aspect-ratio: 16/9; }
  .gal img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 600px) { .gal { grid-template-columns: 1fr 1fr; } }
</style>
