---
import Base from '../../layouts/Base.astro';
import Poster from '../../components/Poster.astro';
import FaceOff from '../../components/FaceOff.astro';
import PhotoSlot from '../../../../shared/components/PhotoSlot.astro';
import Provisional from '../../../../shared/components/Provisional.astro';
import { allShows, venues, dateLong } from '../../../../shared/lib.js';
export function getStaticPaths() { return allShows.map((s) => ({ params: { slug: s.slug }, props: { s: s } })); }
const { s } = Astro.props;
const v = venues[s.venue];
const today = new Date(new Date().toISOString().slice(0, 10));
const past = new Date(s.date) < today;
---
<Base title={s.name} accent={s.color} accentInk={s.ink}>
  <section class="top" style={`--c:${s.color}`}>
    <div class="wrap top-in">
      <div>
        <p class="kicker">{s.brand === 'levelone' ? 'Level One' : 'Triple W'} · {past ? 'Show celebrado' : 'Próximo show'}</p>
        <h1 class="h-xl">{s.name}</h1>
        {s.provisional && <p><Provisional label="Datos de este show provisionales" /></p>}
        <p class="tag">{s.tagline}</p>
        <dl class="meta">
          <div><dt>Fecha</dt><dd>{dateLong(s.date)}</dd></div>
          {s.start && <div><dt>Hora</dt><dd>{s.doors ? `Puertas ${s.doors} · ` : ''}{s.start}</dd></div>}
          <div><dt>Lugar</dt><dd><a href={v.map}>{v.name}</a><small>{v.address}</small></dd></div>
          <div><dt>Entrada</dt><dd>{s.ticket?.type === 'venta' ? 'Anticipada' : 'Inversa: pagas al salir'}</dd></div>
        </dl>
        {!past && s.ticket?.type === 'venta' && <a class="btn" href={s.ticket.url}>Compra tu entrada →</a>}
      </div>
      <div class="poster-col"><Poster show={s} size="l" />{!s.poster && <p class="muted small">Aquí va el cartel real del show.</p>}</div>
    </div>
  </section>

  {!past && (
    <section class="section wrap">
      <h2 class="h-l">Cartelera</h2>
      {s.card?.length ? <div class="cards">{s.card.map((m) => <FaceOff match={m} color={s.color} ink={s.ink} />)}</div>
        : <p class="muted">Cartelera por anunciar. <Provisional /></p>}
    </section>
  )}

  {past && (
    <section class="section wrap two">
      <div>
        <h2 class="h-l">Resultados</h2>
        {s.results?.length ? <ol class="res">{s.results.map((r) => <li>{r.text} {r.provisional && <Provisional />}</li>)}</ol>
          : <p class="muted">Resultados pendientes de pasar desde Instagram. <Provisional /></p>}
      </div>
      <div>
        <h2 class="h-l">Galería</h2>
        {s.galleryProvisional && <p class="muted small">Fotos asignadas a este show por deducción. <Provisional label="Confirmar show" /></p>}
        <div class="gal">
          {(s.gallery?.length ? s.gallery : Array.from({ length: 6 }).map(() => null)).map((src, i) => <PhotoSlot src={src} alt={`Foto de ${s.name}`} tone="#141414" ink={s.color} ratio={i === 0 ? '16/10' : '1/1'} label="Foto @wrestlingphotoshow" class={i === 0 ? 'wide' : ''} />)}
        </div>
      </div>
    </section>
  )}
</Base>
<style>
  .top { background: linear-gradient(160deg, color-mix(in srgb, var(--c) 22%, #0b0b0b), #0b0b0b 70%); border-bottom: 6px solid var(--c); }
  .top-in { display: grid; grid-template-columns: 1.3fr .7fr; gap: 3rem; padding-block: 4rem; align-items: center; }
  .top h1 { color: var(--c); }
  .tag { font-size: 1.2rem; margin-top: 1rem; max-width: 40ch; }
  .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1.2rem; margin: 2rem 0; }
  .meta dt { font: 700 .62rem/1 var(--font-text); letter-spacing: .18em; text-transform: uppercase; color: var(--muted); margin-bottom: .4rem; }
  .meta dd { margin: 0; font: 800 1.25rem/1.05 var(--font-display); text-transform: uppercase; }
  .meta small { display: block; font: 400 .8rem/1.3 var(--font-text); text-transform: none; color: var(--muted); margin-top: .3rem; }
  .small { font-size: .78rem; margin-top: .5rem; }
  @media (max-width: 820px) { .top-in { grid-template-columns: 1fr; } .poster-col { max-width: 340px; } }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 1.2rem; margin-top: 2rem; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
  @media (max-width: 900px) { .two { grid-template-columns: 1fr; } }
  .res { padding-left: 1.2rem; display: grid; gap: .9rem; margin-top: 1.5rem; }
  .res li::marker { color: var(--accent); font-weight: 800; }
  .gal { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: .5rem; margin-top: 1.5rem; }
  .gal :global(.wide) { grid-column: 1 / -1; }
</style>
