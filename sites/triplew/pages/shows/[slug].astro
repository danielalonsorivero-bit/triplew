---
import Base from '../../layouts/Base.astro';
import Poster from '../../components/Poster.astro';
import FaceOff from '../../components/FaceOff.astro';
import Galeria from '../../components/Galeria.astro';
import VideoYT from '../../components/VideoYT.astro';
import Provisional from '../../../../shared/components/Provisional.astro';
import { allShows, venues, dateLong, cronicaBlocks, ticketInfo, pages } from '../../../../shared/lib.js';
export function getStaticPaths() { return allShows.map((s) => ({ params: { slug: s.slug }, props: { s: s } })); }
const { s } = Astro.props;
const v = venues[s.venue];
// Texto para Google y para compartir, hecho solo con los datos del show.
const seoDesc = `${s.name}: lucha libre ${s.brand === 'levelone' ? 'Level One' : 'Triple W'} el ${dateLong(s.date)}${v?.name ? ` en ${v.name}` : ''}.${(s.card || []).length ? ` ${s.card.length} ${s.card.length === 1 ? 'combate' : 'combates'} en el cartel.` : ''}`;
const today = new Date(new Date().toISOString().slice(0, 10));
const past = new Date(s.date) < today;
const words = s.name.split(' ');
// Fondo del hero: heroPhoto (o heroVideo, un MP4 corto en bucle) si se define en shows.json;
// si no, la primera foto de la galería; si no hay fotos, el cartel difuminado de siempre.
const heroBg = s.heroPhoto || s.gallery?.[0];
const cronica = cronicaBlocks(s.cronica);
// Crónica maquetada por capítulos: cada capítulo termina en un resultado y lleva al lado
// una foto pequeña de la galería. Los subtítulos y la frase final ocupan todo el ancho.
const cronPool = (s.gallery || []).filter((_, k) => k % 4 === 2);
const chapters = [];
{ let cur = [];
  const flush = () => { if (cur.length) chapters.push({ kind: 'ch', items: cur, photo: cronPool[chapters.filter((c) => c.kind === 'ch').length] }); cur = []; };
  for (const b of cronica) {
    if (b.kind === 'h' || b.kind === 'close') { flush(); chapters.push(b); continue; }
    cur.push(b);
    if (b.kind === 'res') flush();
  }
  flush(); }
// Pestañas bajo los resultados: galería, vídeos y crónica, solo las que tengan contenido.
const tabs = [
  s.gallery?.length > 0 && { id: 'galeria', label: 'Galería', n: Math.min(s.gallery.length, 30) },
  s.videos?.length > 0 && { id: 'videos', label: 'Vídeos', n: s.videos.length },
  cronica.length > 0 && { id: 'cronica', label: 'Crónica' },
].filter(Boolean);
let n = 0;
---
<Base title={s.name} description={seoDesc} image={s.poster || heroBg} accent={s.color} accentInk={s.ink} overlayHead>
  <section class="top" style={`--c:${s.color}`}>
    <div class:list={['top-bg', { photo: !!heroBg || !!s.heroVideo }]} aria-hidden="true">{s.heroVideo
      ? <video src={s.heroVideo} poster={heroBg} autoplay muted loop playsinline></video>
      : heroBg ? <img src={heroBg} alt="" style={s.heroPos ? `object-position:${s.heroPos}` : undefined} /> : s.poster && <img src={s.poster} alt="" />}<span class="beam b1"><i></i></span><span class="beam b2"><i></i></span></div>
    <div class="wrap top-in">
      <div>
        <p class="brand-line">{s.brand === 'levelone' ? 'Level One' : 'WhiteWolf Wrestling'} {past ? 'presentó' : 'presenta'}</p>
        <h1 class="show-name" aria-label={s.name}>{words.map((w, k) => <span class:list={['wd', { o: k % 2 === 1 }]} aria-hidden="true">{[...w].map((ch) => <span class="ch" style={`--c2:${n++}`}>{ch}</span>)}</span>)}</h1>
        {s.tagline && <p class="tag">{s.tagline}</p>}
        {s.provisional && <p><Provisional label="Datos de este show por confirmar" /></p>}
        <dl class="board">
          <div><dt>Fecha</dt><dd>{dateLong(s.date)}</dd></div>
          {s.start && <div><dt>Hora</dt><dd>{s.start}{s.doors && <small>Puertas {s.doors}</small>}</dd></div>}
          <div><dt>Lugar</dt><dd><a href={v.map}>{v.name}</a><small>{v.address}</small></dd></div>
          <div><dt>Entrada</dt><dd>{ticketInfo(s).board}</dd></div>
        </dl>
        {!past && (
          <div class="cta">
            {s.ticket?.type === 'venta' && s.ticket.url ? <a class="btn" href={s.ticket.url}>Compra tu entrada</a> : <a class="btn" href={v.map}>Cómo llegar</a>}
          </div>
        )}
      </div>
      <div class="poster-col"><Poster show={s} size="l" /></div>
    </div>
  </section>

  {!past && (
    <section class="section wrap">
      <h2 class="h-l">Cartelera</h2>
      {s.card?.length ? <div class="cards">{s.card.map((m) => <FaceOff match={m} color={s.color} />)}</div>
        : <p class="soon">La cartelera se anunciará en las próximas semanas. Síguela en <a href="https://www.instagram.com/latriplew/">@latriplew</a>.</p>}
    </section>
  )}

  {past && (
    <section class="section wrap">
      <h2 class="h-l">Resultados</h2>
      {s.results?.length
        ? <ol class="results">{s.results.map((r, k) => <li><b>{String(k + 1).padStart(2, '0')}</b><span>{r.text} {r.provisional && <Provisional label="Por confirmar" />}</span></li>)}</ol>
        : <p class="soon">Resultados pendientes de publicar.</p>}
      <a class="btn ghost yt-link" href={s.video || pages.sitio.youtube}>{s.video ? 'Ver el show en YouTube' : 'Ve todos los combates en nuestro canal de YouTube'} <span class="arr" aria-hidden="true"></span></a>
    </section>
  )}

  {tabs.length > 0 && (
    <section class="section wrap tabs-sec" data-tabs>
      <div class="tablist" role="tablist" aria-label={`Más de ${s.name}`}>
        {tabs.map((t, k) => <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={k === 0 ? 'true' : 'false'} tabindex={k === 0 ? 0 : -1}>{t.label}{t.n && <small>{t.n}</small>}</button>)}
      </div>
      {tabs.map((t) => (
        <div class="panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} tabindex="0">
          <h2 class="panel-h">{t.label}</h2>
          {t.id === 'galeria' && <>{s.galleryProvisional && <p class="soon"><Provisional label="Fotos por confirmar en este show" /></p>}<Galeria photos={s.gallery} alt={`Foto de ${s.name}`} max={30} /></>}
          {t.id === 'videos' && <div class="vid-grid">{s.videos.map((v) => <VideoYT id={v.youtube} title={v.title} color={s.color} />)}</div>}
          {t.id === 'cronica' && (
            <article class="cron">
              {chapters.map((c) =>
                c.kind === 'h' ? <h3 class="cr-h" set:html={c.html} />
                : c.kind === 'close' ? <p class="cr-close" set:html={c.html} />
                : <section class:list={['cr-ch', { solo: !c.photo }]}>
                    <div class="cr-txt">{c.items.map((b) => <p class={`cr-${b.kind}`} set:html={b.html} />)}</div>
                    {c.photo && <figure class="cr-ph wm"><img src={c.photo} alt={`Foto de ${s.name}`} loading="lazy" /></figure>}
                  </section>)}
            </article>
          )}
        </div>
      ))}
    </section>
  )}
</Base>

<script>
  // Pestañas accesibles: clic, flechas del teclado y enlace directo (#galeria, #videos, #cronica).
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((box) => {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = [...box.querySelectorAll<HTMLElement>('[role=tabpanel]')];
    box.classList.add('js-tabs');
    const pick = (i: number, focus = false) => {
      tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === i)); t.tabIndex = k === i ? 0 : -1; });
      panels.forEach((p, k) => { p.hidden = k !== i; });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => { pick(i); history.replaceState(null, '', '#' + t.id.slice(4)); });
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (d) { e.preventDefault(); pick((i + d + tabs.length) % tabs.length, true); }
      });
    });
    const fromHash = tabs.findIndex((t) => '#' + t.id.slice(4) === location.hash);
    pick(Math.max(0, fromHash));
  });
</script>
<style>
  .top { position: relative; overflow: hidden; isolation: isolate; margin-top: -65px; padding-top: 65px; background: #050506; border-bottom: 2px solid var(--c); }
  .top-bg { position: absolute; inset: 0; z-index: -1; }
  .top-bg img { position: absolute; inset: -10%; width: 120%; height: 120%; object-fit: cover; filter: blur(40px) saturate(1.2) brightness(.35); }
  .top-bg.photo img, .top-bg video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.15) brightness(.5); transform: scale(1.04); animation: bg-drift 24s ease-in-out infinite alternate; }
  @keyframes bg-drift { to { transform: scale(1.1) translateX(-1.5%); } }
  @media (prefers-reduced-motion: reduce) { .top-bg.photo img, .top-bg video { animation: none; } }
  .top-bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(5,5,6,.92) 0%, rgba(5,5,6,.6) 55%, rgba(5,5,6,.3) 100%); }
  .beam { position: absolute; z-index: 1; top: -14%; width: 28vw; min-width: 240px; height: 140%; transform-origin: 50% 0; mix-blend-mode: screen; filter: blur(clamp(18px, 2vw, 34px)); opacity: .6; }
  .beam i { position: absolute; inset: 0; clip-path: polygon(46% 0, 54% 0, 100% 100%, 0 100%); background: radial-gradient(ellipse 60% 90% at 50% 0%, color-mix(in srgb, var(--c) 45%, #fff) 0%, color-mix(in srgb, var(--c) 25%, transparent) 40%, transparent 85%); }
  .b1 { left: 58%; animation: sweep 10s ease-in-out infinite alternate; }
  .b2 { left: 76%; animation: sweep 8s ease-in-out -3s infinite alternate-reverse; opacity: .4; }
  @keyframes sweep { from { rotate: 16deg; } to { rotate: -12deg; } }
  .top-in { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, .7fr); gap: clamp(2rem, 5vw, 4rem); padding-block: clamp(3rem, 7vw, 6rem); align-items: center; }
  .brand-line { font: 700 1rem/1 var(--font-text); color: var(--c); margin: 0 0 1rem; }
  .show-name { font: 900 clamp(3.4rem, 9vw, 8.5rem)/.82 var(--font-display); text-transform: uppercase; display: flex; flex-wrap: wrap; column-gap: .22em; }
  .wd { white-space: nowrap; }
  .wd.o { color: transparent; -webkit-text-stroke: clamp(1.5px, .16vw, 2.5px) var(--fg); }
  .ch { display: inline-block; animation: slam .7s cubic-bezier(.16, 1, .3, 1) both; animation-delay: calc(.3s + var(--c2) * .04s); }
  @keyframes slam { 0% { opacity: 0; transform: translateY(-.12em) scale(2.4); filter: blur(18px); } 55% { opacity: 1; } 100% { opacity: 1; transform: none; filter: none; } }
  .tag { font-size: clamp(1.1rem, 1.6vw, 1.35rem); margin: 1.3rem 0 0; max-width: 42ch; color: #e2dccf; }
  .board { margin: 2rem 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); border-top: 2px solid var(--c); background-color: rgba(10,9,9,.8); background-image: radial-gradient(color-mix(in srgb, var(--c) 14%, transparent) 1.1px, transparent 1.3px); background-size: 5px 5px; }
  .board div { padding: 1rem; border-bottom: 1px solid #1d1d20; }
  .board dt { font: 600 .95rem/1 var(--font-text); color: #b9b3a8; margin-bottom: .5rem; }
  .board dd { margin: 0; font: 800 1.35rem/1.05 var(--font-display); text-transform: uppercase; color: var(--c); }
  .board dd a { color: inherit; }
  .board small { display: block; font: 400 .95rem/1.3 var(--font-text); text-transform: none; color: #c9c2b5; margin-top: .35rem; }
  .cta { margin-top: 1.6rem; }
  .cta .btn { background: var(--c); color: var(--accent-ink); }
  .poster-col { position: relative; }
  .poster-col::before { content: ''; position: absolute; z-index: 1; inset: -10% 5% 35%; pointer-events: none; mix-blend-mode: screen; filter: blur(26px); background: radial-gradient(ellipse 42% 58% at 50% 18%, color-mix(in srgb, var(--c) 40%, #fff), transparent 72%); opacity: .55; }
  @media (max-width: 820px) { .top-in { grid-template-columns: 1fr; } .poster-col { max-width: 340px; } }

  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); gap: 1.2rem; margin-top: 2rem; }
  .soon { font-size: 1.1rem; color: #c9c2b5; margin-top: 1.2rem; max-width: 60ch; }
  .results { list-style: none; padding: 0; margin: 2rem 0 0; max-width: 900px; border-top: 2px solid var(--accent); background-color: #0c0a0b; background-image: radial-gradient(color-mix(in srgb, var(--accent) 14%, transparent) 1.1px, transparent 1.3px); background-size: 5px 5px; }
  .results li { display: grid; grid-template-columns: 3.2rem 1fr; gap: .9rem; align-items: baseline; padding: 1rem; border-bottom: 1px solid #1e1a1c; font-size: 1.05rem; line-height: 1.45; }
  .results b { font: 900 1.8rem/1 var(--font-display); color: var(--accent); font-variant-numeric: tabular-nums; }
  .gal-sec { padding-top: 0; }
  .yt-link { margin-top: 1.6rem; }
  .tabs-sec { padding-top: 0; }
  .tablist { display: none; }
  .js-tabs .tablist { display: flex; gap: clamp(1rem, 3vw, 2.5rem); overflow-x: auto; border-bottom: 1px solid #26262a; scrollbar-width: none; }
  .tablist button { position: relative; flex: none; padding: .4rem 0 1rem; border: 0; background: none; cursor: pointer; font: 900 clamp(1.9rem, 4.2vw, 3.4rem)/.9 var(--font-display); text-transform: uppercase; color: transparent; -webkit-text-stroke: 1.5px #6b6b72; transition: color .3s, -webkit-text-stroke-color .3s; }
  .tablist button small { font: 800 .95rem/1 var(--font-display); -webkit-text-stroke: 0; color: #8b8b92; margin-left: .35rem; vertical-align: top; }
  .tablist button:hover { -webkit-text-stroke-color: var(--fg); }
  .tablist button[aria-selected="true"] { color: var(--fg); -webkit-text-stroke-color: transparent; }
  .tablist button[aria-selected="true"] small { color: var(--accent); }
  .tablist button::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 3px; background: var(--accent); box-shadow: 0 0 14px color-mix(in srgb, var(--accent) 70%, transparent); transform: scaleX(0); transform-origin: left; transition: transform .45s cubic-bezier(.16, 1, .3, 1); }
  .tablist button[aria-selected="true"]::after { transform: none; }
  .tablist button:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .panel { padding-top: .5rem; }
  .panel:focus-visible { outline: none; }
  .panel + .panel { margin-top: 3rem; }
  .js-tabs .panel + .panel { margin-top: 0; }
  .js-tabs .panel-h { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .js-tabs .panel:not([hidden]) { animation: panel-in .5s cubic-bezier(.16, 1, .3, 1); }
  @keyframes panel-in { from { opacity: 0; transform: translateY(10px); } }
  /* Crónica como reportaje: entrada grande, resultados como marcador, fotos intercaladas */
  .cron { max-width: 1100px; margin-top: 1.5rem; }
  .cron p { font-size: 1.12rem; line-height: 1.7; color: #d6cfbf; margin: 0 0 1.3rem; max-width: 62ch; }
  .cron .cr-lead { font: 700 clamp(1.3rem, 2.2vw, 1.75rem)/1.4 var(--font-text); color: var(--fg); max-width: 40ch; margin-bottom: 2rem; padding-left: 1.1rem; border-left: 3px solid var(--accent); }
  .cron .cr-res { font: 800 clamp(1.15rem, 1.8vw, 1.45rem)/1.2 var(--font-display); text-transform: uppercase; letter-spacing: .01em; color: var(--fg); padding: 1rem 1.1rem; margin: .4rem 0 1.8rem; border-top: 2px solid var(--accent); background-color: #0c0a0b; background-image: radial-gradient(color-mix(in srgb, var(--accent) 14%, transparent) 1.1px, transparent 1.3px); background-size: 5px 5px; max-width: 46ch; }
  .cron .cr-res :global(a) { text-decoration: none; color: var(--accent); }
  .cr-h { clear: both; display: flex; align-items: center; gap: 1rem; font: 900 clamp(2.6rem, 6vw, 4.8rem)/.9 var(--font-display); text-transform: uppercase; color: transparent; -webkit-text-stroke: 1.5px var(--accent); margin: 3rem 0 1.4rem; }
  .cr-h::after { content: ''; flex: 1; height: 2px; background: linear-gradient(90deg, var(--accent), transparent); }
  .cron .cr-close { clear: both; font: 900 clamp(1.8rem, 4vw, 3.2rem)/.95 var(--font-display); text-transform: uppercase; color: var(--fg); max-width: 22ch; margin: 2.5rem 0 0; padding-top: 1.5rem; border-top: 1px solid #26262a; }
  .cr-ch { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 340px); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; padding: 1.6rem 0; border-top: 1px solid #1d1d20; }
  .cr-ch:first-of-type { border-top: 0; padding-top: 0; }
  .cr-ch.solo { grid-template-columns: minmax(0, 1fr); }
  .cr-txt > :last-child { margin-bottom: 0; }
  .cr-ph { margin: 0; aspect-ratio: 4/3; overflow: hidden; background: #111; position: sticky; top: 90px; }
  .cr-ph img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.1) brightness(.85); transition: filter .5s; }
  .cr-ph:hover img { filter: none; }
  .cron :global(a) { color: var(--fg); font-weight: 700; text-decoration-color: var(--accent); text-underline-offset: .18em; }
  .cron :global(a:hover) { color: var(--accent); }
  @media (max-width: 760px) { .cr-ch { grid-template-columns: 1fr; } .cr-ph { position: static; order: -1; } }
  .vid-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 560px), 1fr)); gap: 1.5rem; margin-top: 1.5rem; }
  .gal { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; margin-top: 1.5rem; }
  .gal figure { margin: 0; aspect-ratio: 1; overflow: hidden; background: #111; }
  .gal figure.wide { grid-column: 1 / -1; aspect-ratio: 16/9; }
  .gal img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 600px) { .gal { grid-template-columns: 1fr 1fr; } }
</style>
