---
// Campeonatos: cada cinturón es un escenario. El campeón bajo un foco del color del título,
// su nombre entra de golpe al aparecer en pantalla y el linaje se lee en un marcador LED.
// Textos: shared/data/paginas-triplew.json (campeonatos) y shared/data/titles.json.
import Base from '../layouts/Base.astro';
import Provisional from '../../../shared/components/Provisional.astro';
import { titles, wrestler } from '../../../shared/lib.js';
import pages from '../../../shared/data/paginas-triplew.json';
const txt = pages.campeonatos;
const hof = txt.hallOfFame;
---
<Base title="Campeonatos">
  <section class="head wrap">
    <h1 class="h-xl">Campeonatos</h1>
    <p class="intro">{txt.intro}</p>
  </section>

  <div class="stages">
    {titles.map((t, i) => {
      const h = t.holder && wrestler(t.holder);
      const img = h?.photos?.find((p) => p.includes('cinturon')) ?? h?.photo;
      return (
        <article class:list={['stage', { flip: i % 2 === 1, vacant: !h }]} style={`--t:${t.color}`} data-reveal>
          <div class="st-ph">
            {img
              ? <img src={img} alt={h ? `${h.name}, ${t.name}` : ''} loading="lazy" style={`object-position:${(h.photoPos || 'center 20%').split(' ')[0]} 12%`} />
              : <span class="st-q" aria-hidden="true">{h ? h.name.slice(0, 1) : '?'}</span>}
            <span class="st-beam" aria-hidden="true"><i></i></span>
          </div>
          <div class="st-body">
            <h2 class="st-title">{t.name}</h2>
            <p class="st-label">Campeón actual</p>
            {h
              ? <a class="st-holder" href={`/roster/${h.slug}/`} aria-label={h.name}>{[...h.name].map((ch, k) => <span class="ch" style={`--k:${k}`} aria-hidden="true">{ch === ' ' ? ' ' : ch}</span>)}</a>
              : <p class="st-holder none">Vacante <Provisional label="Por confirmar" /></p>}
            <div class="lin">
              <h3>Linaje {t.provisionalHistory && <Provisional label="Incompleto" />}</h3>
              {t.history.length
                ? <ol>{t.history.map((x, k) => <li><b>{String(k + 1).padStart(2, '0')}</b><span><strong>{x.name}</strong>{x.note && <small>{x.note}</small>}</span></li>)}</ol>
                : <p class="lin-empty">Sin datos todavía.</p>}
            </div>
          </div>
        </article>
      );
    })}
  </div>

  <section class="hof wrap" data-reveal>
    <h2 class="hof-t">{[...hof.title].map((ch, k) => <span style={`--k:${k}`}>{ch === ' ' ? ' ' : ch}</span>)}</h2>
    <p>{hof.text} {hof.provisional && <Provisional label="Por confirmar" />}</p>
  </section>
</Base>

<script>
  document.documentElement.classList.add('js');
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('lit-on'); io.unobserve(e.target); } }), { threshold: .3 });
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
</script>

<style>
  .head { padding-block: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 3vw, 2.5rem); }
  .intro { font-size: clamp(1.15rem, 1.8vw, 1.45rem); max-width: 38ch; margin: 1.2rem 0 0; color: #e2dccf; }

  .stages { display: grid; }
  .stage { position: relative; display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); min-height: clamp(460px, 48vw, 640px); border-top: 1px solid #1a1a1c; background: #060607; overflow: hidden; isolation: isolate; }
  .stage.flip { grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); }
  .stage.flip .st-ph { order: 2; }
  .st-ph { position: relative; overflow: hidden; background: #0c0c0e; }
  .st-ph img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.2) brightness(.95); transition: filter 1.2s cubic-bezier(.16, 1, .3, 1), transform 1.6s cubic-bezier(.16, 1, .3, 1); }
  .st-ph::after { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(90deg, transparent 55%, #060607 100%); }
  .flip .st-ph::after { background: linear-gradient(270deg, transparent 55%, #060607 100%); }
  .st-q { position: absolute; inset: 0; display: grid; place-items: center; font: 900 clamp(14rem, 30vw, 26rem)/1 var(--font-display); color: transparent; -webkit-text-stroke: 2px color-mix(in srgb, var(--t) 55%, #333); background: repeating-linear-gradient(135deg, #0c0c0e 0 14px, #101013 14px 28px); }
  /* Foco cenital del color del cinturón: difuminado, se mece despacio */
  .st-beam { position: absolute; z-index: 1; top: -12%; left: 50%; width: 80%; height: 125%; translate: -50% 0; transform-origin: 50% 0; mix-blend-mode: screen; filter: blur(clamp(16px, 2vw, 30px)); opacity: .8; transition: opacity 1s; animation: sway 9s ease-in-out infinite alternate; pointer-events: none; }
  .st-beam i { position: absolute; inset: 0; clip-path: polygon(44% 0, 56% 0, 100% 100%, 0 100%); background: radial-gradient(ellipse 60% 85% at 50% 0%, color-mix(in srgb, var(--t) 50%, #fff) 0%, color-mix(in srgb, var(--t) 28%, transparent) 40%, transparent 85%); }
  @keyframes sway { from { rotate: 7deg; } to { rotate: -7deg; } }

  .st-body { position: relative; z-index: 2; align-self: center; padding: clamp(2rem, 5vw, 4.5rem) clamp(1.2rem, 5vw, 4.5rem); }
  .st-title { font: 800 clamp(1.3rem, 2vw, 1.7rem)/1 var(--font-display); text-transform: uppercase; letter-spacing: .02em; color: var(--t); }
  .st-label { margin: 1.6rem 0 .3rem; font: 600 1rem/1 var(--font-text); color: #b9b3a8; }
  .st-holder { display: block; width: fit-content; font: 900 clamp(3.2rem, 7.5vw, 7rem)/.84 var(--font-display); text-transform: uppercase; color: var(--fg); text-decoration: none; margin: 0; }
  .st-holder .ch { display: inline-block; }
  .st-holder:hover { color: var(--t); }
  .st-holder.none { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; color: transparent; -webkit-text-stroke: 2px var(--fg); }
  .st-holder.none :global(.provisional) { -webkit-text-stroke: 0; }

  .lin { margin-top: clamp(1.8rem, 3vw, 2.6rem); max-width: 520px; }
  .lin h3 { font: 700 1rem/1 var(--font-text); color: #e9e3d6; display: flex; gap: .6rem; align-items: center; flex-wrap: wrap; margin-bottom: .7rem; }
  .lin ol { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--t); background-color: #0b0a0a; background-image: radial-gradient(color-mix(in srgb, var(--t) 15%, transparent) 1.1px, transparent 1.3px); background-size: 5px 5px; }
  .lin li { display: grid; grid-template-columns: 2.6rem 1fr; gap: .7rem; align-items: baseline; padding: .8rem .9rem; border-bottom: 1px solid #1e1c1c; }
  .lin li b { font: 900 1.4rem/1 var(--font-display); color: var(--t); font-variant-numeric: tabular-nums; }
  .lin li strong { font: 800 1.25rem/1 var(--font-display); text-transform: uppercase; }
  .lin li small { display: block; font-size: .95rem; line-height: 1.35; color: #c9c2b5; margin-top: .3rem; }
  .lin-empty { color: #c9c2b5; font-size: 1rem; }

  /* Encendido al entrar en pantalla */
  :global(.js) .stage:not(.lit-on) .st-ph img { filter: grayscale(1) contrast(1.15) brightness(.45); transform: scale(1.06); }
  :global(.js) .stage:not(.lit-on) .st-beam { opacity: .2; }
  :global(.js) .stage .ch { opacity: 0; }
  :global(.js) .stage.lit-on .ch { animation: slam .7s cubic-bezier(.16, 1, .3, 1) both; animation-delay: calc(.35s + var(--k) * .045s); }
  @keyframes slam { 0% { opacity: 0; transform: translateY(-.12em) scale(2.4); filter: blur(18px); } 55% { opacity: 1; } 100% { opacity: 1; transform: none; filter: none; } }

  .hof { padding-block: clamp(4rem, 9vw, 7rem); text-align: center; position: relative; }
  .hof::before { content: ''; position: absolute; inset: 0 15% 20%; z-index: -1; pointer-events: none; background: radial-gradient(ellipse 50% 70% at 50% 0%, rgba(232, 197, 71, .22), transparent 75%); filter: blur(20px); }
  .hof-t { font: 900 clamp(3rem, 9vw, 7.5rem)/.85 var(--font-display); text-transform: uppercase; color: #E8C547; }
  .hof-t span { display: inline-block; }
  :global(.js) .hof-t span { opacity: .12; }
  :global(.js) .hof.lit-on .hof-t span { animation: neon 1.3s steps(1) both; animation-delay: calc(var(--k) * .06s); }
  @keyframes neon { 0% { opacity: .12; } 20% { opacity: 1; text-shadow: 0 0 22px rgba(232, 197, 71, .7); } 30% { opacity: .2; } 45%, 100% { opacity: 1; text-shadow: 0 0 22px rgba(232, 197, 71, .45); } }
  .hof p { font-size: 1.1rem; max-width: 46ch; margin: 1.5rem auto 0; color: #d6cfbf; }

  @media (max-width: 820px) {
    .stage, .stage.flip { grid-template-columns: 1fr; min-height: 0; }
    .stage.flip .st-ph { order: 0; }
    .st-ph { aspect-ratio: 4/3; }
    .st-ph::after, .flip .st-ph::after { background: linear-gradient(0deg, #060607 0%, transparent 45%); }
    .st-body { padding-top: 0; margin-top: -3.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .st-beam { animation: none; }
    :global(.js) .stage .ch, :global(.js) .hof-t span { opacity: 1; animation: none !important; }
  }
</style>
