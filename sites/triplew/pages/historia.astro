---
// Historia: un pasillo de hitos. Cada año aparece como un rótulo apagado (solo contorno)
// que se enciende al llegar a él, y la foto de archivo pasa de penumbra a luz.
// Textos: shared/data/paginas-triplew.json (historia).
import Base from '../layouts/Base.astro';
import Provisional from '../../../shared/components/Provisional.astro';
import pages from '../../../shared/data/paginas-triplew.json';
import { upcomingShows, dateLong } from '../../../shared/lib.js';
const { intro, hitos, cierre } = pages.historia;
const next = upcomingShows[0];
---
<Base title="Historia">
  <section class="head wrap">
    <h1 class="h-xl">Historia</h1>
    <p class="intro">{intro}</p>
  </section>

  <ol class="tl">
    {hitos.map((h, i) => (
      <li class:list={['hito', { r: i % 2 === 1 }]} data-reveal>
        <div class="h-ph">{h.photo && <img src={h.photo} alt="" loading="lazy" />}</div>
        <div class="h-txt">
          <span class="h-y" aria-hidden="true">{h.year}</span>
          <h2 class="h-t"><span class="sr">{h.year}: </span>{h.title}</h2>
          <p>{h.text} {h.provisional && <Provisional label={h.provisional} />}</p>
        </div>
      </li>
    ))}
  </ol>

  {cierre && (
    <section class="cierre wrap" data-reveal>
      <h2 class="c-t">{cierre.title}</h2>
      <p>{cierre.text}</p>
      <div class="c-links">
        <a class="c-btn" href="/salon-de-la-fama/">{cierre.hofLink} →</a>
        {next
          ? <a class="c-btn c-show" href={`/shows/${next.slug}/`}><span class="c-k">{cierre.showLink}</span>{next.name} · {dateLong(next.date)} →</a>
          : <a class="c-btn c-show" href="/shows/">Shows →</a>}
      </div>
    </section>
  )}
</Base>

<script>
  document.documentElement.classList.add('js');
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('lit-on'); io.unobserve(e.target); } }), { threshold: .35 });
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
</script>

<style>
  .head { padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 4vw, 3.5rem); }
  .intro { font-size: clamp(1.15rem, 1.8vw, 1.45rem); max-width: 40ch; margin: 1.2rem 0 0; color: #e2dccf; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  .tl { list-style: none; margin: 0; padding: 0; display: grid; }
  .hito { position: relative; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); min-height: clamp(380px, 40vw, 560px); border-top: 1px solid #1a1a1c; background: #060607; overflow: hidden; isolation: isolate; }
  .hito.r { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); }
  .hito.r .h-ph { order: 2; }
  .h-ph { position: relative; overflow: hidden; background: #0c0c0e; }
  .h-ph img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.15) brightness(.9); transition: filter 1.2s cubic-bezier(.16, 1, .3, 1), transform 1.8s cubic-bezier(.16, 1, .3, 1); }
  .h-ph::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, transparent 50%, #060607 100%); }
  .r .h-ph::after { background: linear-gradient(270deg, transparent 50%, #060607 100%); }
  /* Foco sobre la foto */
  .h-ph::before { content: ''; position: absolute; z-index: 1; inset: -10% 10% 25%; pointer-events: none; mix-blend-mode: screen; filter: blur(24px); background: radial-gradient(ellipse 45% 75% at 50% 0%, rgba(255, 250, 240, .55), transparent 75%); transition: opacity 1.2s; }

  .h-txt { position: relative; z-index: 2; align-self: center; justify-self: start; padding: clamp(2rem, 5vw, 4.5rem) clamp(1.2rem, 5vw, 4.5rem); }
  .r .h-txt { justify-self: end; }
  .h-y { display: block; font: 900 clamp(5rem, 13vw, 11rem)/.8 var(--font-display); color: #fbf6ec; text-shadow: 0 0 34px rgba(255, 244, 225, .45), 0 0 80px rgba(255, 238, 210, .18); margin-bottom: 1.2rem; transition: color .2s, text-shadow .2s; }
  .h-t { font: 900 clamp(2rem, 3.6vw, 3.2rem)/.9 var(--font-display); text-transform: uppercase; }
  .h-txt p { font-size: 1.1rem; line-height: 1.5; color: #d6cfbf; max-width: 40ch; margin: 1rem 0 0; }

  /* Apagado hasta que llegas: el año es solo contorno y la foto está en penumbra */
  :global(.js) .hito:not(.lit-on) .h-y { color: transparent; -webkit-text-stroke: 2px #3a3a3e; text-shadow: none; }
  :global(.js) .hito:not(.lit-on) .h-ph img { filter: grayscale(1) contrast(1.1) brightness(.35); transform: scale(1.06); }
  :global(.js) .hito:not(.lit-on) .h-ph::before { opacity: 0; }
  :global(.js) .hito.lit-on .h-y { animation: neon 1.2s steps(1) both .2s; }
  @keyframes neon { 0% { color: transparent; -webkit-text-stroke: 2px #3a3a3e; text-shadow: none; } 15% { color: #fbf6ec; -webkit-text-stroke: 0; text-shadow: 0 0 40px rgba(255, 244, 225, .75); } 25% { color: transparent; -webkit-text-stroke: 2px #3a3a3e; text-shadow: none; } 40%, 100% { color: #fbf6ec; -webkit-text-stroke: 0; text-shadow: 0 0 34px rgba(255, 244, 225, .45), 0 0 80px rgba(255, 238, 210, .18); } }

  /* Cierre */
  .cierre { position: relative; text-align: center; padding-block: clamp(4.5rem, 10vw, 8rem); }
  .cierre::before { content: ''; position: absolute; inset: 0 15% 25%; z-index: -1; pointer-events: none; background: radial-gradient(ellipse 50% 70% at 50% 0%, rgba(255, 244, 225, .2), transparent 75%); filter: blur(22px); }
  .c-t { font: 900 clamp(3rem, 8vw, 6.5rem)/.95 var(--font-display); text-transform: uppercase; color: #fbf6ec; text-shadow: 0 0 34px rgba(255, 244, 225, .35); }
  .cierre p { font-size: 1.1rem; line-height: 1.5; max-width: 46ch; margin: 1.5rem auto 0; color: #d6cfbf; }
  .c-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; margin-top: 2.2rem; }
  .c-btn { display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: .35rem; padding: 1rem 1.5rem; font: 800 1rem/1.1 var(--font-display); letter-spacing: .1em; text-transform: uppercase; color: #fbf6ec; text-decoration: none; border: 1.5px solid #fbf6ec; transition: background .2s, color .2s; }
  .c-btn:hover { background: #fbf6ec; color: #0b0b0b; }
  .c-k { font-size: .72rem; letter-spacing: .2em; opacity: .7; }

  @media (max-width: 820px) {
    .hito, .hito.r { grid-template-columns: 1fr; min-height: 0; }
    .hito.r .h-ph { order: 0; }
    .h-ph { aspect-ratio: 16/10; }
    .h-ph::after, .r .h-ph::after { background: linear-gradient(0deg, #060607 0%, transparent 50%); }
    .h-txt, .r .h-txt { justify-self: stretch; margin-top: -3rem; padding-top: 0; }
    .c-links { flex-direction: column; }
    .c-btn { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { :global(.js) .hito.lit-on .h-y { animation: none; } }
</style>
