---
// "Cara a cara": los dos lados del combate se miran separados por una diagonal de luz.
// Lado sin luchador conocido ("Por anunciar"): silueta oscura con interrogante.
import Provisional from '../../../shared/components/Provisional.astro';
import { findByName } from '../../../shared/lib.js';
import Rumble from './Rumble.astro';
const { match, color } = Astro.props;
// Rumble o tres o más luchadores: no caben en el cara a cara, van en cuadrícula.
const many = match.type === 'rumble' || (match.sides ?? []).filter((n) => n?.trim()).length > 2;
const sides = (match.sides ?? []).slice(0, 2).map((name) => ({ name, w: findByName(name) }));
const solo = sides.length < 2;
---
{many ? <Rumble match={match} color={color} /> : (
<article class:list={['fo', { solo }]} style={`--c:${color}`}>
  <div class="fo-ring">
    {sides.map((x, k) => {
      const Tag = x.w ? 'a' : 'div';
      return (
        <Tag class:list={['fo-side', k ? 'fo-b' : 'fo-a', { unknown: !x.w?.photo }]} href={x.w ? `/roster/${x.w.slug}/` : undefined}>
          {x.w?.photo
            ? <img src={x.w.photo} alt="" loading="lazy" decoding="async" style={`object-position:${(x.w.photoPos || 'center 20%').split(' ')[0]} 8%`} />
            : <span class="fo-q" aria-hidden="true">?</span>}
          <span class="fo-name">{x.name}</span>
        </Tag>
      );
    })}
    {!solo && <span class="fo-vs" aria-label="contra">VS</span>}
  </div>
  <div class="fo-info">
    <h3 class="fo-title">{match.title} {match.provisional && <Provisional label="Por confirmar" />}</h3>
    {match.note && <p class="fo-note">{match.note}</p>}
  </div>
</article>
)}

<style>
  .fo { --h: clamp(260px, 26vw, 380px); display: grid; background: #070708; border: 1px solid #1d1d1f; }
  .fo-ring { position: relative; height: var(--h); overflow: hidden; isolation: isolate; }
  .fo-side { position: absolute; top: 0; bottom: 0; width: 58%; text-decoration: none; overflow: hidden; background: #0d0d0f; }
  .fo-a { left: 0; clip-path: polygon(0 0, 100% 0, 72% 100%, 0 100%); }
  .fo-b { right: 0; clip-path: polygon(28% 0, 100% 0, 100% 100%, 0 100%); }
  .solo .fo-a { width: 100%; clip-path: none; }
  .fo-side img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.15) brightness(.7); transition: filter .5s, transform .8s cubic-bezier(.16, 1, .3, 1); }
  .fo-side::before { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(0deg, rgba(5,5,6,.95) 0%, rgba(5,5,6,0) 55%); }
  /* Foco cenital que se enciende al pasar por encima */
  .fo-side::after { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; mix-blend-mode: screen; opacity: 0; transition: opacity .4s;
    background: radial-gradient(ellipse 45% 80% at 50% -10%, color-mix(in srgb, var(--c) 45%, #fff) 0%, transparent 70%); }
  .fo-side:hover img, .fo-side:focus-visible img { filter: grayscale(1) contrast(1.2) brightness(1); transform: scale(1.04); }
  .fo-side:hover::after, .fo-side:focus-visible::after { opacity: .55; }
  .fo-name { position: absolute; z-index: 2; bottom: 1rem; left: 1.1rem; right: 30%; font: 900 clamp(1.9rem, 3.4vw, 3.3rem)/.85 var(--font-display); text-transform: uppercase; color: var(--fg); text-wrap: balance; }
  .fo-b .fo-name { left: 30%; right: 1.1rem; text-align: right; }
  .solo .fo-name { right: 1.1rem; font-size: clamp(2.4rem, 5vw, 4.4rem); }
  .unknown { background: repeating-linear-gradient(135deg, #0c0c0e 0 14px, #101013 14px 28px); }
  .fo-q { position: absolute; inset: 0; display: grid; place-items: center; font: 900 calc(var(--h) * .7)/1 var(--font-display); color: transparent; -webkit-text-stroke: 2px color-mix(in srgb, var(--c) 55%, #333); }
  .fo-b .fo-q { padding-left: 25%; } .fo-a .fo-q { padding-right: 25%; }
  /* La diagonal: una línea de luz del color del show */
  .fo-ring::after { content: ''; position: absolute; z-index: 3; top: -5%; bottom: -5%; left: 50%; width: 3px; background: var(--c); transform: rotate(12.5deg); box-shadow: 0 0 18px 2px color-mix(in srgb, var(--c) 70%, transparent); pointer-events: none; }
  .solo .fo-ring::after { display: none; }
  .fo-vs { position: absolute; z-index: 4; left: 50%; top: 50%; translate: -50% -50%; font: 900 clamp(2rem, 3.4vw, 3rem)/1 var(--font-display); color: var(--c); background: #070708; padding: .35em .25em; text-shadow: 0 0 16px color-mix(in srgb, var(--c) 70%, transparent); }
  .fo-info { padding: 1rem 1.1rem 1.2rem; border-top: 1px solid #1d1d1f; }
  .fo-title { font: 800 1.35rem/1 var(--font-display); text-transform: uppercase; letter-spacing: .01em; color: var(--fg); display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; }
  .fo-note { margin: .5rem 0 0; font-size: 1rem; line-height: 1.45; color: #b9b3a8; max-width: 60ch; }
</style>
