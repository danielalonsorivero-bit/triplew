---
// Vídeo de YouTube "bajo el foco": hasta que se pulsa, solo se ve la miniatura en blanco y negro
// con un botón de play; al pulsar se carga el reproductor de YouTube (modo sin cookies).
// Así la página carga rápido y YouTube no rastrea a quien no reproduce.
// Props: id (el código del vídeo, lo que va tras "v=" en el enlace), title, color.
const { id, title = 'Vídeo', color = 'var(--accent)' } = Astro.props;
---
<figure class="yt" style={`--c:${color}`}>
  <button type="button" class="yt-btn" data-yt={id} aria-label={`Reproducir: ${title}`}>
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" />
    <span class="yt-play" aria-hidden="true"></span>
  </button>
  <figcaption>{title} <a href={`https://www.youtube.com/watch?v=${id}`} rel="noopener">Ver en YouTube ↗</a></figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLButtonElement>('.yt-btn').forEach((b) => b.addEventListener('click', () => {
    const f = document.createElement('iframe');
    f.src = `https://www.youtube-nocookie.com/embed/${b.dataset.yt}?autoplay=1&rel=0`;
    f.title = b.getAttribute('aria-label') ?? 'Vídeo';
    f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    f.allowFullscreen = true;
    b.replaceWith(f);
  }, { once: true }));
</script>

<style>
  .yt { margin: 0; }
  .yt-btn, .yt :global(iframe) { display: block; width: 100%; aspect-ratio: 16/9; border: 0; padding: 0; background: #000; }
  .yt-btn { position: relative; cursor: pointer; overflow: hidden; isolation: isolate; }
  .yt-btn img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.15) brightness(.6); transition: filter .5s, transform .8s cubic-bezier(.16, 1, .3, 1); }
  .yt-btn::before { content: ''; position: absolute; inset: -10% 15% 20%; z-index: 1; pointer-events: none; mix-blend-mode: screen; filter: blur(20px); background: radial-gradient(ellipse 45% 75% at 50% 0%, color-mix(in srgb, var(--c) 45%, #fff), transparent 75%); opacity: .35; transition: opacity .4s; }
  .yt-btn:hover img, .yt-btn:focus-visible img { filter: grayscale(.2) contrast(1.1) brightness(.9); transform: scale(1.03); }
  .yt-btn:hover::before, .yt-btn:focus-visible::before { opacity: .7; }
  .yt-btn:focus-visible { outline: 3px solid var(--c); outline-offset: 3px; }
  .yt-play { position: absolute; z-index: 2; left: 50%; top: 50%; translate: -50% -50%; width: clamp(64px, 9vw, 96px); aspect-ratio: 1; border: 3px solid var(--c); border-radius: 50%; display: grid; place-items: center; background: rgba(5, 5, 6, .55); box-shadow: 0 0 24px color-mix(in srgb, var(--c) 45%, transparent); transition: transform .4s cubic-bezier(.16, 1, .3, 1); }
  .yt-play::after { content: ''; width: 32%; aspect-ratio: .87; margin-left: 9%; background: var(--c); clip-path: polygon(0 0, 100% 50%, 0 100%); }
  .yt-btn:hover .yt-play { transform: scale(1.08); }
  .yt figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 1rem; padding: .8rem 0 0; font: 800 1.15rem/1.1 var(--font-display); text-transform: uppercase; }
  .yt figcaption a { font: 600 .95rem/1.1 var(--font-text); text-transform: none; color: #c9c2b5; }
</style>
