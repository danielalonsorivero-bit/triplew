---
// Cromo de luchador "bajo el foco": en penumbra hasta que pasas el ratón (o lo enfocas);
// entonces se enciende un foco cenital, la foto gana luz y sube un panel con sus datos.
// Datos opcionales de ficha técnica (se muestran solo si existen en roster.json):
//   hometown (procedencia), debut, finisher (movimiento final).
import PhotoSlot from '../../../shared/components/PhotoSlot.astro';
import { divisions, initials, titleOf } from '../../../shared/lib.js';
const { w, n } = Astro.props;
const div = divisions[w.division];
const champ = (w.titles || []).map(titleOf).filter(Boolean);
const facts = [
  w.hometown && ['De', w.hometown],
  w.debut && ['Debut', w.debut],
  w.finisher && ['Remate', w.finisher],
].filter(Boolean);
---
<a class="cromo" href={`/roster/${w.slug}/`} style={`--d:${div.color}`}>
  <div class="c-ph">
    <PhotoSlot src={w.photo} pos={w.photoPos} alt="" initials={initials(w.name)} tone="#121214" ink={div.color} ratio="3/4" label="" />
  </div>
  <span class="c-spot" aria-hidden="true"></span>
  {champ.length > 0 && <span class="c-belt">Campeón {champ.map((t) => t.short).join(' / ')}</span>}
  <span class="c-body">
    {n && <span class="c-num">{String(n).padStart(2, '0')}</span>}
    <span class="c-n">{w.name}</span>
    <span class="c-more">
      {w.nickname && <span class="c-nick">«{w.nickname}»</span>}
      <span class="c-div">{div.name}</span>
      {facts.length > 0 && <span class="c-facts">{facts.map(([k, v]) => <span><b>{k}</b> {v}</span>)}</span>}
      <span class="c-go">Ver ficha →</span>
    </span>
  </span>
</a>

<style>
  .cromo { position: relative; display: block; aspect-ratio: 3/4; overflow: hidden; text-decoration: none; background: #0c0c0e; border: 1px solid #1d1d20; isolation: isolate; }
  .c-ph { position: absolute; inset: 0; }
  .c-ph :global(.slot) { height: 100%; }
  .c-ph :global(img) { filter: grayscale(1) contrast(1.15) brightness(.55); transform: scale(1.02); transition: filter .6s cubic-bezier(.16, 1, .3, 1), transform 1s cubic-bezier(.16, 1, .3, 1); }
  .cromo::after { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(0deg, rgba(5,5,6,.96) 0%, rgba(5,5,6,.55) 38%, rgba(5,5,6,0) 62%); pointer-events: none; }
  /* Foco cenital: luz blanca con un toque del color de la división */
  .c-spot { position: absolute; z-index: 1; inset: -10% -20% 30%; pointer-events: none; mix-blend-mode: screen; opacity: 0; transition: opacity .35s;
    background: radial-gradient(ellipse 42% 75% at 50% 0%, color-mix(in srgb, var(--d) 30%, #fff) 0%, color-mix(in srgb, var(--d) 18%, transparent) 45%, transparent 75%); filter: blur(6px); }
  .c-belt { position: absolute; z-index: 2; top: .6rem; left: .6rem; font: 800 .82rem/1 var(--font-display); letter-spacing: .06em; text-transform: uppercase; background: #E8C547; color: #1a1400; padding: .35rem .5rem; }
  .c-body { position: absolute; z-index: 2; inset: auto 0 0 0; padding: .9rem; display: grid; }
  .c-num { font: 800 .9rem/1 var(--font-display); color: var(--d); letter-spacing: .06em; font-variant-numeric: tabular-nums; }
  .c-n { font: 900 clamp(1.5rem, 2.4vw, 2.1rem)/.88 var(--font-display); text-transform: uppercase; color: var(--fg); margin-top: .2rem; transform-origin: 0 100%; }
  .c-more { display: grid; gap: .3rem; max-height: 0; opacity: 0; overflow: hidden; transition: max-height .5s cubic-bezier(.16, 1, .3, 1), opacity .3s, margin .5s; }
  .c-nick { font: 700 1.05rem/1.15 var(--font-display); text-transform: uppercase; color: #e9e3d6; }
  .c-div { font: 700 .82rem/1 var(--font-text); color: var(--d); }
  .c-facts { display: grid; gap: .15rem; font-size: .85rem; color: #cfc8bb; }
  .c-facts b { font-weight: 700; color: #fff; }
  .c-go { font: 800 .9rem/1 var(--font-display); text-transform: uppercase; letter-spacing: .06em; color: var(--fg); margin-top: .3rem; }

  /* Encendido */
  .cromo:hover .c-spot, .cromo:focus-visible .c-spot { opacity: 1; animation: spot-on .5s steps(1) both; }
  @keyframes spot-on { 0% { opacity: 1; } 15% { opacity: .2; } 30%, 100% { opacity: 1; } }
  .cromo:hover :global(img), .cromo:focus-visible :global(img) { filter: grayscale(1) contrast(1.2) brightness(1.02); transform: scale(1.07); }
  .cromo:hover .c-n, .cromo:focus-visible .c-n { animation: c-slam .55s cubic-bezier(.16, 1, .3, 1) both; }
  @keyframes c-slam { from { transform: scale(1.25); filter: blur(8px); opacity: .3; } to { transform: none; filter: none; opacity: 1; } }
  .cromo:hover .c-more, .cromo:focus-visible .c-more { max-height: 12rem; opacity: 1; margin-top: .5rem; }

  /* En pantallas táctiles no hay "pasar el ratón": la tarjeta ya sale iluminada y con el apodo */
  @media (hover: none) {
    .c-spot { opacity: .6; }
    .c-ph :global(img) { filter: grayscale(1) contrast(1.18) brightness(.9); }
    .c-more { max-height: 12rem; opacity: 1; margin-top: .4rem; }
    .c-facts, .c-go { display: none; }
  }
</style>
