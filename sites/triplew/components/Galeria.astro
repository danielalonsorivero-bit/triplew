---
// Galería con visor: cuadrícula de fotos (la primera más grande) que se abren a pantalla
// completa al pulsarlas, con flechas, teclado y gesto de deslizar. Todas llevan el lobo
// como marca de agua. Props: photos (lista de rutas), alt (texto para cada foto), max (límite).
const { photos = [], alt = '', max = 10 } = Astro.props;
const list = photos.slice(0, max);
---
{list.length > 0 && (
  <div class="gx" data-gx>
    <div class:list={['gx-grid', `n${Math.min(list.length, 5)}`]}>
      {list.map((src, k) => (
        <button type="button" class="gx-it wm" data-k={k} aria-label={`Ampliar foto ${k + 1} de ${list.length}`}>
          <img src={src} alt={alt} loading="lazy" decoding="async" />
        </button>
      ))}
    </div>
    <dialog class="gx-dlg" aria-label="Visor de fotos">
      <figure class="gx-fig wm"><img alt={alt} /></figure>
      <p class="gx-count" aria-live="polite"></p>
      <button type="button" class="gx-btn gx-x" data-act="close" aria-label="Cerrar">×</button>
      {list.length > 1 && <button type="button" class="gx-btn gx-p" data-act="prev" aria-label="Foto anterior">←</button>}
      {list.length > 1 && <button type="button" class="gx-btn gx-n" data-act="next" aria-label="Foto siguiente">→</button>}
    </dialog>
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-gx]').forEach((gx) => {
    const items = [...gx.querySelectorAll<HTMLButtonElement>('.gx-it')];
    const srcs = items.map((b) => b.querySelector('img')!.getAttribute('src')!);
    const dlg = gx.querySelector('dialog')!;
    const img = dlg.querySelector('img')!;
    const count = dlg.querySelector('.gx-count')!;
    let k = 0;
    const show = (n: number) => { k = (n + srcs.length) % srcs.length; img.src = srcs[k]; count.textContent = `${k + 1} / ${srcs.length}`; };
    items.forEach((b, n) => b.addEventListener('click', () => { show(n); dlg.showModal(); }));
    dlg.addEventListener('click', (e) => {
      const act = (e.target as HTMLElement).closest<HTMLElement>('[data-act]')?.dataset.act;
      if (act === 'close' || e.target === dlg) dlg.close();
      if (act === 'prev') show(k - 1);
      if (act === 'next') show(k + 1);
    });
    dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(k - 1); if (e.key === 'ArrowRight') show(k + 1); });
    let x0 = 0;
    dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dlg.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) show(dx < 0 ? k + 1 : k - 1); });
    dlg.addEventListener('close', () => items[k]?.focus());
  });
</script>

<style>
  .gx-grid { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: clamp(140px, 16vw, 230px); gap: .5rem; margin-top: 1.4rem; }
  .gx-it { padding: 0; border: 0; margin: 0; cursor: zoom-in; overflow: hidden; background: #111; }
  .gx-it:first-child { grid-column: span 2; grid-row: span 2; }
  .n1 .gx-it:first-child { grid-column: 1 / -1; grid-row: span 3; }
  .gx-it img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(.15); transition: transform .7s cubic-bezier(.16, 1, .3, 1), filter .4s; }
  .gx-it:hover img, .gx-it:focus-visible img { transform: scale(1.04); filter: none; }
  .gx-it:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  @media (max-width: 700px) { .gx-grid { grid-template-columns: 1fr 1fr; grid-auto-rows: 42vw; } }

  .gx-dlg { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(4, 4, 5, .96); color: var(--fg); }
  .gx-dlg::backdrop { background: rgba(0, 0, 0, .8); }
  .gx-dlg[open] { display: grid; place-items: center; }
  .gx-fig { margin: 0; max-width: 92vw; max-height: 86dvh; display: grid; }
  .gx-fig img { max-width: 92vw; max-height: 86dvh; object-fit: contain; }
  .gx-fig.wm::after { width: clamp(40px, 7%, 80px); }
  .gx-count { position: absolute; left: 1.2rem; top: 1rem; margin: 0; font: 800 1.1rem/1 var(--font-display); font-variant-numeric: tabular-nums; }
  .gx-btn { position: absolute; width: 3rem; height: 3rem; border: 1px solid #333; background: rgba(10, 10, 12, .8); color: var(--fg); font-size: 1.5rem; line-height: 1; cursor: pointer; }
  .gx-btn:hover, .gx-btn:focus-visible { border-color: var(--accent); color: var(--accent); }
  .gx-x { right: 1rem; top: 1rem; }
  .gx-p { left: 1rem; top: 50%; translate: 0 -50%; }
  .gx-n { right: 1rem; top: 50%; translate: 0 -50%; }
</style>
